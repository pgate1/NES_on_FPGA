
// Sprite memory

%i "../mem/ram_8x256.h"

circuit sprite_ram
{
	input adrs<8>, din<8>;
	instrin read(adrs), write(adrs, din);
	output dout<8>;
	instrin clear;

	ram_8x256 ram;

	stage_name clear_stg { task do(); }

	instruct write par{
		sel wdata<8>;
		// attribute
		if(adrs<1:0>==0b10) wdata = din & 0xE3;
		else wdata = din;
		ram.write(adrs, wdata);
	}

	instruct read ram.read(adrs);
	dout = ram.dout;

	instruct clear par{
		clear_stg.do();
	}

	stage clear_stg {
		reg_wr mem_adrs<6>;
		par{
			ram.write(mem_adrs || 0b00, 0xF0); // YÀ•W240
			mem_adrs++;
			if(/&mem_adrs) finish;
		}
	}
}
