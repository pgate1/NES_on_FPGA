
// Picture Processing Unit

%i "sprite_ram.h"
%i "palette_ram.h"

%d NONE            0b0000
%d BG_NAME         0b0010
%d BG_ATTRIBUTE    0b0011
%d BG_PAT_LOW_TMP  0b0100
%d BG_PAT_HIGH_TMP 0b0101
%d SPR_PAT_LOW     0b1000
%d SPR_PAT_HIGH    0b1001
%d TMP_READ_2007   0b1111

circuit PictureProcessingUnit
{
	/* for 6502 */
	input A<3>, Din<8>;
	output Dout<8>;
	reg A_reg<3>, Dout_reg<8>;
	instrin io_write(A, Din), io_read(A);
	instrout io_ack;
	reg_wr io_read_inst, io_read_pallet;
	output o_NMI;
	reg_wr NMI_reg;

	/* for CHR-ROM */
	output PA<14>, PDout<8>;
	reg PA_reg<14>, PDout_reg<8>;
	input PDin<8>;
	instrout chr_read_req, chr_write_req;
	instrself chr_read(read_id, PA), chr_write(PA, PDout);
	instrin chr_read_ack;
	sel read_id<4>;
	reg read_id_reg<4>;

	instrin soft_reset, spr_ram_clear, draw;

	instrin hblank;
	reg_wr hsync_buf;
	reg_wr bg_fetch_do, spr_search_do, spr_fetch_do, draw_do;
	reg_ws vblank_do;

	/* for VIDEO */
	output VIDEO<6>;
	instrout VIDEO_enable;

	reg_ws reset;
	instrself reset_act;

	/* status flags */
	reg_wr f_vblank, f_spr_hit, f_spr_over;
	reg_wr f_2005_2006;
	reg tmp_read_2007<8>;
	reg chr_adrs<14>;

	/* config flags */
	reg_wr f_NMI_enable, f_spr_size;
	reg_wr f_bg_pat_base, f_spr_pat_base;
	reg_wr f_adrs_inc;
	reg_wr name_id<2>, name_id_t<2>;

	reg_wr f_spr_enable;//, f_spr_enable_tmp;
	reg_wr f_bg_enable;//, f_bg_enable_tmp;
	sel fetch_enable;
	reg_wr f_bg_left_clip, f_spr_left_clip;
	reg_wr f_col_mono, spr_ram_adrs<8>;

	reg_wr bg_scroll_x<8>, bg_scroll_x_t<8>;
	reg_wr bg_scroll_y<8>, bg_scroll_y_t<8>;
	instrself inc_chr_adrs;
	sel bg_name_y<5>, bg_name_x<5>;

	reg scanline<9>;
	reg bg_name_data<8> , bg_attr_data<8>, bg_attr_hl<2>;
	reg bg_attr_high<16>, bg_attr_low<16>;
	reg bg_pat_low<16> , bg_pat_low_tmp<8>;
	reg bg_pat_high<16>, bg_pat_high_tmp<8>;

	reg_wr spr_fetch_on;

	sprite_ram spr_ram;
	palette_ram pal_ram;

	mem spr_tmp_y[8]<4>;
	mem spr_tmp_idx[8]<8>;
	mem spr_tmp_attr[8]<8>; // VHP000CC
	mem spr_tmp_x[8]<8>;
	mem spr_buf_patl[8]<8>;
	mem spr_buf_path[8]<8>;
	mem spr_buf_attr[8]<8>; // VHP000CC
	mem spr_buf_x[8]<8>;
	reg_wr spr_zero_tmp, spr_zero;

	reg_wr spr_buf_set<8>;
	regs spr_draw_on[8];

	reg buf_read<3>;
	sel check_x<8>;
	instrself spr_x_check(check_x);

	instrself halt(h_code);
	sel h_code<8>;
	reg_wr halt_code_reg<8>;
	output halt_code<8>;

	// NSF拡張
	output f_nmi_en;
	reg_ws first_nmi_disable;

output dbg<8>;
reg_wr dbg_reg<8>;
reg_wr hhh;

	stage_name Frame { task do(); }
	stage_name VBlank { task do(); }
	stage_name BG_Fetch { task do(); }
	stage_name SPR_Search { task do(); }
	stage_name SPR_Fetch { task do(); }
	stage_name Draw { task do(); }
	stage_name chr_read_wait { task do(read_id_reg); }

	if(reset){
		reset_act();
		reset := 0b0;
	}

	instruct reset_act par{
		f_NMI_enable := 0b0;
		f_vblank := 0b0;
		vblank_do := 0b1;
		bg_fetch_do := 0b0;
		spr_search_do := 0b0;
		spr_fetch_do := 0b0;
		first_nmi_disable := 0b1;
		NMI_reg := 0b0;
		f_2005_2006 := 0b0;
	}

	instruct soft_reset par{
		reset := 0b1;
	}

	instruct spr_ram_clear par{
		spr_ram.clear();
	}

	if(io_read_inst) Dout_reg := Dout;
	else Dout = Dout_reg;

	fetch_enable = f_bg_enable | f_spr_enable;

	o_NMI = f_NMI_enable & NMI_reg & f_vblank & ^first_nmi_disable;

	if(chr_read | chr_write) PA_reg := PA;
	else PA = PA_reg;

	if(chr_write) PDout_reg := PDout;
	else PDout = PDout_reg;

	// NSF拡張
	f_nmi_en = f_NMI_enable;

	instruct halt halt_code_reg := h_code;
	halt_code = halt_code_reg;

dbg = dbg_reg;

	instruct io_write par{
		any{
			A==0b000 : par{ // $2000
				f_NMI_enable := Din<7>;
				if(^f_NMI_enable & Din<7> & f_vblank) NMI_reg := 0b1;
				f_spr_size := Din<5>;
				f_bg_pat_base := Din<4>;
				f_spr_pat_base := Din<3>;
				f_adrs_inc := Din<2>;
				name_id_t := Din<1:0>;
			}
			A==0b001 : par{ // $2001
				f_spr_enable := Din<4>;
				f_bg_enable := Din<3>;
				f_spr_left_clip := ^Din<2>; // 0:clip
				f_bg_left_clip := ^Din<1>; // 0:clip
				f_col_mono := Din<0>;
			}
			A==0b010 : ;    // $2002 none
			A==0b011 : par{ // $2003
				spr_ram_adrs := Din;
			}
			A==0b100 : par{ // $2004
				spr_ram.write(spr_ram_adrs, Din);
				spr_ram_adrs++;
			}
			A==0b101 : par{ // $2005
				if(f_2005_2006){ // second write
					bg_scroll_y_t := Din; // フレーム
				}
				else{ // first write
					bg_scroll_x_t := Din; // ライン
				}
				f_2005_2006 := ^f_2005_2006;
			}
			A==0b110 : par{ // $2006
				if(f_2005_2006){ // second write
					chr_adrs := chr_adrs<13:8> || Din;

					name_id := name_id_t;
					bg_scroll_x_t := Din<4:0> || bg_scroll_x_t<2:0>;
					bg_scroll_y_t := bg_scroll_y_t<7:6> || Din<7:5> || bg_scroll_y_t<2:0>;
					bg_scroll_y   := bg_scroll_y_t<7:6> || Din<7:5> || bg_scroll_y_t<2:0>;
				}
				else{ // first write
					chr_adrs := Din<5:0> || chr_adrs<7:0>;

					name_id_t := Din<3:2>;
					bg_scroll_y_t := Din<1:0> || bg_scroll_y_t<5:3> || 0b0 || Din<5:4>;
				}
				f_2005_2006 := ^f_2005_2006;
			}
			A==0b111 : par{ // $2007
				if(/&chr_adrs<13:8>){ // $3F00～$3FFF
					pal_ram.write(chr_adrs<4:0>, Din);
				}
				else{
					chr_write(chr_adrs, Din);
				}
				inc_chr_adrs();
			}
		}
	}

	instruct io_read par{
		any{
		//	A==0b010 : ;    // $2002
			A==0b100 : par{ // $2004
				spr_ram.read(spr_ram_adrs);
			}
			A==0b111 : par{ // $2007
				if(/&chr_adrs<13:8>){ // $3F00～$3FFF
					pal_ram.read(chr_adrs<4:0>);
					io_read_pallet := 0b1;
				}
				chr_read(TMP_READ_2007, chr_adrs);
				inc_chr_adrs();
			}
		}
		A_reg := A;
		io_read_inst := 0b1;
	}

	if(io_read_inst){
		any{
			A_reg==0b010 : par{ // $2002
				Dout = f_vblank || f_spr_hit || f_spr_over || 0b00000;
				f_vblank := 0b0;
				f_2005_2006 := 0b0;
			}
			A_reg==0b100 : par{ // $2004
				Dout = spr_ram.dout;
			}
			A_reg==0b111 : par{ // $2007
				if(io_read_pallet){
					Dout = pal_ram.dout;
				}
				else{
					Dout = tmp_read_2007;
				}
				io_read_pallet := 0b0;
			}
		}
		io_ack();
		io_read_inst := 0b0;
	}

	instruct inc_chr_adrs par{
		if(vblank_do | (^f_bg_enable & ^f_spr_enable)){
			if(f_adrs_inc) chr_adrs += 32;
			else           chr_adrs += 1;
		}
		else{ // 描画中のアドレス加算
			// X加算
			if(bg_name_x==31){
				bg_scroll_x := 5#0b0 || bg_scroll_x<2:0>;
				name_id := name_id<1> || ^name_id<0>;
				chr_adrs := chr_adrs<13:11> || ^chr_adrs<10> || chr_adrs<9:5> || 5#0b0;
			}
			else{
				bg_scroll_x += 8;
				chr_adrs++;
			}

			// Y加算
			if(bg_scroll_y<2:0>==7){
				if(bg_scroll_y<7:3>==29){
					bg_scroll_y := 0;
					name_id := ^name_id<1> || name_id<0>;
					chr_adrs := 0b00 || ^chr_adrs<11> || chr_adrs<10:0>;
				}
			//	else if(bg_scroll_y<7:3>==31){
			//		bg_scroll_y := 0;
			//		chr_adrs := 0b0000 || chr_adrs<9:0>;
			//	}
				else{
					bg_scroll_y := (bg_scroll_y<7:3> + 0b00001) || 0b000;
					chr_adrs := 0b00 || chr_adrs<11:10> || (bg_scroll_y<7:3> + 0b00001) || chr_adrs<4:0>;
				}
			}
			else{
				bg_scroll_y++;
				chr_adrs += 0b01_0000_0000_0000;
			}
		}
	}

	instruct chr_read par{
		chr_read_req();
		generate chr_read_wait.do(read_id);
	}

	instruct chr_write par{
		chr_write_req();
	}

	// スプライトX座標をチェック
	instruct spr_x_check par{
		// 描画開始時なら描画フラグを立てる
		par(i=0;i<8;i++){
			if(spr_buf_x[i]==check_x) spr_draw_on[i] := spr_buf_set<i>;
		}
	}

	instruct draw par{
		any{
			bg_fetch_do   : generate BG_Fetch.do();
			spr_search_do : generate SPR_Search.do();
			spr_fetch_do  : if(spr_fetch_on) generate SPR_Fetch.do();
			vblank_do  : generate VBlank.do();
			^vblank_do : generate Draw.do();
		}
	}

	instruct hblank par{
		bg_scroll_x := bg_scroll_x_t;
	//	f_spr_enable := f_spr_enable_tmp;
	//	f_bg_enable := f_bg_enable_tmp;
		hsync_buf := 0b1;
		generate Frame.do();
if(^hhh) halt(0x45);
	}

	// 水平同期時の管理
	// ラインの最初に起動、コメントは起動後のline
	stage Frame {
		reg_wr frame<8>; // for sim
		first_state st_vb_begin;
		finish;
		state st_vb_begin par{ // 240 (0) VBlank start
			vblank_do := 0b1;

			bg_fetch_do := 0b0;
			spr_search_do := 0b0;
			spr_fetch_do := 0b0;

			scanline := 240;
			goto st_nmi;
		}
		state st_nmi par{ // 241 (1)
			f_vblank := 0b1; // to $2002<7>
			if(f_NMI_enable & ^first_nmi_disable) NMI_reg := 0b1;
			scanline++;
			goto st_vb;
		}
		state st_vb par{ // 242 (2) - 260 (20)
			if(scanline==259) goto st_vb_end;
			scanline++;
		}
		state st_vb_end par{ // 261(-1) (21)
			bg_fetch_do := 0b1;
			spr_search_do := 0b1;
			spr_fetch_do := 0b1;

			// 次フレームのための準備
			f_vblank := 0b0;

			// スクロール値などはスプライトヒットクリア後に
			// 反映されるようにすること(FF2)
			f_spr_hit := 0b0;

			first_nmi_disable := 0b0;
			NMI_reg := 0b0;
			scanline++; // 261
			goto st_draw0;
		}
		state st_draw0 par{ // draw line 0
			name_id := name_id_t;
			bg_scroll_y := bg_scroll_y_t;

			// 前フレームで検索されたスプライトがライン0で表示されないように
		//	spr_buf_set := 0x00;

			vblank_do := 0b0;

			frame++;
			scanline := 0;
			goto st_draw;
		}
		state st_draw par{ // draw line 1 - 239
			if(scanline==238) goto st_vb_begin;
			scanline++;
		}
	}

	stage VBlank {
		par{
			if(hsync_buf){
				hsync_buf := 0b0;
			}
			finish;
		}
	}

	// BGパターンの読み込み
	// new (4 * 34 + 2) * 2 = 138 * 2 = 276
	stage BG_Fetch {
		sel bg_name_base<4>, bg_attribute_base<8>;
		reg_wr tile_x<6>;
		first_state st_bg_name;
		par{
			bg_name_base = 0b10 || name_id;
			bg_name_y = bg_scroll_y<7:3>;
			bg_name_x = bg_scroll_x<7:3> + tile_x<4:0>;
			bg_attribute_base = bg_name_base || 0b1111;
			finish;
		}
		state st_bg_name par{
			// パターンレジスタの更新
			bg_attr_low  := bg_attr_low<7:0>  || 8#bg_attr_hl<0>;
			bg_attr_high := bg_attr_high<7:0> || 8#bg_attr_hl<1>;
			bg_pat_low  := bg_pat_low<7:0>  || bg_pat_low_tmp;
			bg_pat_high := bg_pat_high<7:0> || bg_pat_high_tmp;

			if(tile_x==2){
				if(^vblank_do) draw_do := 0b1;
				spr_x_check(0x00); // X=0のスプライト表示のため
			}

			if(fetch_enable){
				// read nametable 0b10_nnyy_yyyx_xxxx
				chr_read(BG_NAME, bg_name_base || bg_name_y || bg_name_x);
			}
			goto st_bg_name_wait;
		}
		state st_bg_name_wait goto st_bg_attr;
		state st_bg_attr par{
			if(fetch_enable){
				// read attribute 0b10_nn11_11yy_yxxx
				chr_read(BG_ATTRIBUTE, bg_attribute_base || bg_name_y<4:2> || bg_name_x<4:2>);
			}
			goto st_bg_attr_wait;
		}
		state st_bg_attr_wait goto st_bg_patl;
		state st_bg_patl par{
			if(fetch_enable){
				// read pat low 0b0b_nnnn_nnnn_0yyy
				chr_read(BG_PAT_LOW_TMP, 0b0 || f_bg_pat_base || bg_name_data || 0b0 || bg_scroll_y<2:0>);
			}
			goto st_bg_patl_wait;
		}
		state st_bg_patl_wait goto st_bg_path;
		state st_bg_path par{
			if(fetch_enable){
				// read pat high 0b0b_nnnn_nnnn_1yyy
				chr_read(BG_PAT_HIGH_TMP, 0b0 || f_bg_pat_base || bg_name_data || 0b1 || bg_scroll_y<2:0>);
			}
			goto st_bg_path_wait;

			if(tile_x==33) spr_fetch_on := 0b1;
		}
		state st_bg_path_wait par{
			// BGパレット選択
			bg_attr_hl := (bg_attr_data >> (bg_name_y<1> || bg_name_x<1> || 0b0))<1:0>;

			if((tile_x==33) ){//& fetch_enable){
				// ネームテーブルの切り替え(Y方向)
				if(bg_scroll_y==0xEF){ // 239 ok
					name_id := ^name_id<1> || name_id_t<0>;
					bg_scroll_y := 0;
				}
				else{
					name_id := name_id<1> || name_id_t<0>;
					bg_scroll_y++;
				}
			}
			else{
				// ネームテーブルX境界越え
				if(bg_name_x==31) name_id := name_id<1> || ^name_id<0>;
			}

			any{
				tile_x==1 : goto st_bg_dummy;
				tile_x==33 : goto st_bg_end;
				else : goto st_bg_name;
			}
			tile_x++;
		}
		state st_bg_dummy par{
			if(fetch_enable){
				chr_read(BG_NAME, bg_name_base || bg_name_y || bg_name_x);
			}
			goto st_bg_dummy_wait;
		}
		state st_bg_dummy_wait par{
			// 2回実行
			reg_wr dummy_count;
			if(dummy_count==0b0){
				dummy_count := 0b1;
				goto st_bg_dummy;
			}
			else{
				dummy_count := 0b0;
				goto st_bg_name;
			}
		}
		state st_bg_end if(hsync_buf){
			// 次スキャンラインのための準備
			tile_x := 0;
			hsync_buf := 0b0;
			spr_fetch_on := 0b0;
			goto st_bg_name;
		}
	}

	// 次のラインで描画されるスプライトの探索
	// 描画するスプライトのみ読み取り（実機はこちらっぽい）
	// 32 + 3*8 + 2 = 58
	stage SPR_Search {
		reg_wr spr_adrs<6>, spr_tmp_num<4>;
		sel spr_adrs_inc<6>, tmp_index<3>;
		instrself srch_end;
		first_state st_spr_srch_begin;
		par{
			tmp_index = spr_tmp_num<2:0>;
			finish;
		}
		state st_spr_srch_begin par{
			spr_adrs := 0b000000;
			spr_tmp_num := 0b0000;
			spr_zero_tmp := 0b0;
			f_spr_over := 0b0;
			// 8x16モードでspr_baseを1とするために非表示インデックスは0xFFで初期化
			par(i=0;i<8;i++){
				spr_tmp_idx[i] := 0xFF;
			}
		//	par(i=0;i<8;i++){
		//		spr_tmp_y[i] := 0; // 仮
		//	}
			if(f_spr_enable){
				spr_ram.read(0x00); // Y座標
				goto st_spr_srch_check_y;
			}
			else goto st_spr_srch_end;
		}
		state st_spr_srch_check_y par{
			// 次のラインで描画するか
			sel scan_sub<9>;
			scan_sub = scanline - (0b0 || spr_ram.dout);
			if( //(spr_ram.dout<7:4>!=0xF) & // spr_y < 240
				(scan_sub<8:4>==0b00000)
			    & ((f_spr_size==0b1) | ((f_spr_size==0b0) & (scan_sub<3>==0b0)))
			){ // 描画する
				spr_tmp_y[tmp_index] := scan_sub<3:0>;
				spr_ram.read(spr_adrs || 0b01); // パターンインデックス
				goto st_spr_srch_read_idx;
			}
			else{ // 描画しない
				spr_adrs_inc = spr_adrs + 1;
				spr_adrs := spr_adrs_inc;
				spr_ram.read(spr_adrs_inc || 0b00); // Y座標
				if(/&spr_adrs) goto st_spr_srch_end;
			}
		}
		state st_spr_srch_read_idx par{
			spr_tmp_idx[tmp_index] := spr_ram.dout;
			spr_ram.read(spr_adrs || 0b10); // アトリビュート
			goto st_spr_srch_read_attr;
		}
		state st_spr_srch_read_attr par{
			spr_tmp_attr[tmp_index] := spr_ram.dout;
			spr_ram.read(spr_adrs || 0b11); // X座標
			goto st_spr_srch_read_x;
		}
		state st_spr_srch_read_x par{
			spr_tmp_x[tmp_index] := spr_ram.dout;

			if(spr_adrs==0) spr_zero_tmp := 0b1;

			if(spr_tmp_num==7){ // 8個以上
				f_spr_over := 0b1;
				srch_end();
			}
			spr_tmp_num++;

			spr_adrs_inc = spr_adrs + 1;
			spr_adrs := spr_adrs_inc;
			spr_ram.read(spr_adrs_inc || 0b00); // Y座標

			if(/&spr_adrs | srch_end) goto st_spr_srch_end;
			else goto st_spr_srch_check_y;
		}
		state st_spr_srch_end if(hsync_buf){
			// 描画フラグへの変換
			spr_buf_set := ^(8#0b1 << spr_tmp_num);
			goto st_spr_srch_begin;
		}
	}

	// スプライトパターンの読み込み
	// new8 (2 + 2) * 8 * 2 = 32 * 2 = 64
	// new16 2 * 16 * 2 = 64
	stage SPR_Fetch {
		reg_wr buf_index<3>;
		sel spr_pat_base, spr_pat_index<8>, spr_pat_y<3>;
		first_state st_spr_fetch_begin;
		par{
			// スプライト高さ
			if(f_spr_size){ // 16 height
				spr_pat_base = spr_tmp_idx[buf_index]<0>;
				spr_pat_index = spr_tmp_idx[buf_index]<7:1> || (spr_tmp_attr[buf_index]<7> @ spr_tmp_y[buf_index]<3>);
			}
			else{ // 8 height
				spr_pat_base = f_spr_pat_base;
				spr_pat_index = spr_tmp_idx[buf_index];
			}
			// スプライト上下反転
			if(spr_tmp_attr[buf_index]<7>) spr_pat_y = ^spr_tmp_y[buf_index]<2:0>;
			else                           spr_pat_y =  spr_tmp_y[buf_index]<2:0>;
			finish;
		}
		state st_spr_fetch_begin par{
			goto st_spr_fetch_dummy;
		}
		state st_spr_fetch_dummy par{
			if(fetch_enable){
				// ダミーフェッチ
				chr_read(NONE, 0b10_0000_0000_0000); // 0x2000
			}
			goto st_spr_fetch_dummy_wait;
		}
		state st_spr_fetch_dummy_wait par{
			// 2回実行
			reg_wr dummy_count;
			if(dummy_count==0b0){
				dummy_count := 0b1;
				goto st_spr_fetch_dummy;
			}
			else{
				dummy_count := 0b0;
				goto st_spr_fetch_patl;
			}
		}
		state st_spr_fetch_patl par{
			spr_buf_x[buf_index] := spr_tmp_x[buf_index];
			spr_buf_attr[buf_index] := spr_tmp_attr[buf_index];
			buf_read := buf_index;

			if(fetch_enable){
				// 0b0b_nnnn_nnnn_0yyy
				chr_read(SPR_PAT_LOW, 0b0 || spr_pat_base || spr_pat_index || 0b0 || spr_pat_y);
			}
			goto st_spr_fetch_patl_wait;
		}
		state st_spr_fetch_patl_wait goto st_spr_fetch_path;
		state st_spr_fetch_path par{
			if(fetch_enable){
				// 0b0b_nnnn_nnnn_1yyy
				chr_read(SPR_PAT_HIGH, 0b0 || spr_pat_base || spr_pat_index || 0b1 || spr_pat_y);
			}
			goto st_spr_fetch_path_wait;
		}
		state st_spr_fetch_path_wait par{
			if(buf_index==7){
				goto st_spr_fetch_end;
			}
			else goto st_spr_fetch_dummy;
			buf_index++;
		}
		state st_spr_fetch_end if(hsync_buf){
			// 描画スプライトにゼロスプライトが含まれているかどうか
			spr_zero := spr_zero_tmp;
			// 例えばこの位置で描画開始フラグをクリアする
			par(i=0;i<8;i++){
				spr_draw_on[i] := 0b0;
			}
			goto st_spr_fetch_begin;
		}
	}

	// BG SPR 描画
	stage Draw {
		sels spr_col[8]<5>;
		sel spr_mcol<5>;
		first_state st_draw;
		state st_draw par{
			if(draw_do){
				reg_wr draw_x<8>;
				sel mask<16>, bg_col_low<2>, bg_col_high<2>;
				mask = 0x8000 >> ((0b0 || bg_scroll_x<2:0>) + (0b0 || draw_x<2:0>));
				bg_col_low  = ((bg_pat_high  & mask)!=0) || ((bg_pat_low  & mask)!=0);
				bg_col_high = ((bg_attr_high & mask)!=0) || ((bg_attr_low & mask)!=0);

				// スプライトカラー
				par(i=0;i<8;i++){
					spr_col[i] = spr_buf_attr[i]<5> || spr_buf_attr[i]<1:0> || spr_buf_path[i]<7> || spr_buf_patl[i]<7>;
				}
				// 描画されるべきスプライト選択、低インデックス優先
				alt(i=0;i<8;i++){
					spr_draw_on[i] & /|spr_col[i]<1:0> : spr_mcol = spr_col[i];
					else : spr_mcol = 0b10000;
				}

				sel spr_face<4>, bg_face<4>;
				// ライン0でスプライトが表示されないように
				spr_face = spr_mcol<3:0> & (0b11 || 2#(scanline<7:0>!=0));
				bg_face = bg_col_high || bg_col_low;

				// draw_x < 8
				sel bg_left_clip, spr_left_clip;
				bg_left_clip  = f_bg_left_clip  & (draw_x<7:3>==0b00000);
				spr_left_clip = f_spr_left_clip & (draw_x<7:3>==0b00000);

				sel pal_adrs<5>;
				alt{
					f_spr_enable & ^spr_left_clip & /|spr_face<1:0> & ^spr_mcol<4> : par{ // SPR front
						pal_adrs = 0b1 || spr_face;
					}
					f_bg_enable & ^bg_left_clip & /|bg_face<1:0> : par{ // BG front
						pal_adrs = 0b0 || bg_face;
					}
					f_spr_enable & ^spr_left_clip & /|spr_face<1:0> & spr_mcol<4> : par{ // SPR back
						pal_adrs = 0b1 || spr_face;
					}
					else : par{ // back color
						pal_adrs = 0b00000;
					}
				}
				pal_ram.read(pal_adrs);

				// スプライト0ヒットチェック
				sel zero_draw;
				zero_draw = spr_zero & spr_draw_on_0 & /|spr_col_0<1:0>;
				if(fetch_enable & zero_draw & /|bg_face<1:0>){
					f_spr_hit := 0b1;
				}

				// スプライトパターンバッファを左シフト
				any(i=0;i<8;i++){
					spr_draw_on[i] : par{ spr_buf_patl[i] <<= 1; spr_buf_path[i] <<= 1; }
				}

				sel draw_x_inc<8>;
				draw_x_inc = draw_x + 0x01;
				spr_x_check(draw_x_inc);

				// 256ドットで描画終了
				if(draw_x==255) draw_do := 0b0;
				draw_x := draw_x_inc;
				goto st_vout;
			}
			else finish;
		}
		state st_vout par{
			if(f_col_mono) VIDEO = pal_ram.dout<5:4> || 0x0;
			else VIDEO = pal_ram.dout<5:0>;
			VIDEO_enable();
			goto st_draw;
			finish;
		}
	}

	// レジスタ読み込み
	stage chr_read_wait {
		par{
			sel spr_pat<8>;
			// ビットリバース
			if(spr_tmp_attr[buf_read]<6>) spr_pat = PDin<0:7>;
			else                          spr_pat = PDin;

			if(chr_read_ack){
				switch(read_id_reg){
					case BG_NAME         : bg_name_data    := PDin;
					case BG_ATTRIBUTE    : bg_attr_data    := PDin;
					case BG_PAT_LOW_TMP  : bg_pat_low_tmp  := PDin;
					case BG_PAT_HIGH_TMP : bg_pat_high_tmp := PDin;
					case SPR_PAT_LOW     : spr_buf_patl[buf_read] := spr_pat;
					case SPR_PAT_HIGH    : spr_buf_path[buf_read] := spr_pat;
					case TMP_READ_2007   : tmp_read_2007 := PDin;
				}
				finish;
			}
		}
	}

}
