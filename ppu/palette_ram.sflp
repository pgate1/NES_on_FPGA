
// Pallete RAM

%i "../mem/ram_8x32.h"

circuit palette_ram
{
	input adrs<5>, din<8>;
	instrin read(adrs), write(adrs, din);
	output dout<8>;

	ram_8x32 ram;

	instruct write par{
		if(adrs<3:0>==0b0000) ram.write(0b00000, din);
		else ram.write(adrs, din);
	}

	instruct read par{
		if(adrs<1:0>==0b00) ram.read(0b00000);
		else ram.read(adrs);
	}
	dout = ram.dout;
}
