
/*
	NES on FPGA feat. DE0
	NSF Player on FPGA feat. DE0
	Copyright (c) 2014 pgate1.

	prg : SDRAM
	chr : SDRAM
*/

%i "../../../DE0/chatmask.h"
%i "../../../DE0/seg7_ctrl.h"
%i "../../../DE0/sdram8_ctrl.h"
%i "../../../DE0/SDHCcard_ctrl_SPImode.h"
%i "../../../DE0/FAT32.h"
%i "../../../DE0/lcd_ctrl.h"
%i "../../../DE0/keyboard_ctrl.h"
%i "../../../DE0/vjtag_uart.h"

%i "../NintendoEntertainmentSystem.h"
%i "../mmc/MultiMemoryController.h"
%i "display_4.h"
%i "../../../hdl/VGA_ctrl.h"
%i "../../../hdl/dsdac7.h"
%i "DDS_50to5369318.h"
//%i "DDS_50to1662607.h"
%i "dsdac16.h"
%i "segtim.h"
%i "wave_effect.h"

declare Mapper_enable interface { output enable<256>; }

#define VRC7

circuit core
{
	input BUTTON<3>;
	chatmask cmask_0, cmask_1, cmask_2;
	sels btn[3];
	input SW<10>;
	seg7_ctrl seg7_0, seg7_1, seg7_2, seg7_3;
	sel seg<16>;
	output HEX0<7>, HEX1<7>, HEX2<7>, HEX3<7>;
	output LEDG<10>;
//--------------------- SDRAM Interface --------------------
	output SDRAM_CSn, SDRAM_WEn, SDRAM_DEn;
	output SDRAM_RASn, SDRAM_CASn;
	output SDRAM_BA<2>, SDRAM_ADDR<12>;
	output SDRAM_LDQM, SDRAM_UDQM;
	input  SDRAM_Din<16>;
	output SDRAM_Dout<16>;
	sdram8_ctrl sdram;
//--------------------- SD_Card Interface ------------------
	output SD_CSn; // SD Card CSn
	output SD_CLK; // SD Card Clock
	output SD_CMD; // SD Card Command & Dout
	input  SD_DAT; // SD Card Data
	SDHCcard_ctrl_SPImode sdcard;
	FAT32 fat;
//--------------------- PS/2 -------------------------------
	input PS2_KBCLK, PS2_KBDAT;
	keyboard_ctrl kb;
	mem keys[256]; // 127まで使用
//--------------------- VGA --------------------------------
	output VGA_HS, VGA_VS;
	output VGA_R<4>, VGA_G<4>, VGA_B<4>;
	reg_wr VGA_R_reg<4>, VGA_G_reg<4>, VGA_B_reg<4>;
	VGA_ctrl vga;
	Display_4 dis;
	reg_ws dis_timing;
//-------------------- SOUND -------------------------------
	dsdac16 dac_L, dac_R;
	output Sound_Left, Sound_Right;
//--------------------- LCD --------------------------------
	lcd_ctrl lcd;
	output LCD_RS, LCD_RW, LCD_EN, LCD_DATA<8>;

	vjtag_uart vjtag;

	reg_ws reset;

	reg_wr prg_read_ok;

	// NES
	NintendoEntertainmentSystem nes;
	MultiMemoryController mmc;
	Mapper_enable mapper_enable;

	reg_wr file_num<8>;

	sel sound_L_clip<14>, sound_R_clip<14>;
	sel sound_L<14>, sound_R<14>;

	reg note_count<17>;
	dsdac7 dac_sq1, dac_sq2, dac_tri, dac_noi, dac_dmc;
	dsdac7 dac_mmc5, dac_n106, dac_fds, dac_vrc6, dac_sn5b, dac_vrc7;
	reg note_sq1<7>, note_sq2<7>, note_tri<7>, note_noi<7>, note_dmc<7>;
	reg note_mmc5<7>, note_n106<7>, note_fds<7>, note_vrc6<7>, note_sn5b<7>, note_vrc7<7>;

	segtim segtim_0, segtim_1, segtim_2, segtim_3;

	DDS_50to5369318 dds_ntsc;
//	DDS_50to1662607 dds_pal;

	wave_effect wave;

	stage_name nes_line { task do(); }
	stage_name clock3580k { task do(); }
	stage_name key2btn { task do(); }
	stage_name key_seek { task next(); task back(); }
	stage_name card2ram { task do(); }
	stage_name tas_stg { task do(); }
	stage_name vjtag2ram { task do(); }
	stage_name prg_set_wait { task do(); }
	stage_name lcd_view { task do(); }

	if(reset){
		generate clock3580k.do();
		generate card2ram.do();
		file_num := 0;
		generate key2btn.do();
		generate lcd_view.do();
		reset := 0b0;
	}

	par(i=0;i<3;i++){
		cmask[i].bin = ^BUTTON<i>; btn[i] = cmask[i].bout;
	}

	if(mmc.f_nes | SW<1>){
		HEX3 = seg7_3.con(seg<15:12>).oSEG;
		HEX2 = seg7_2.con(seg<11: 8>).oSEG;
		HEX1 = seg7_1.con(seg< 7: 4>).oSEG;
		HEX0 = seg7_0.con(seg< 3: 0>).oSEG;
	}
	else{
		HEX3 = segtim_3.oSEG;
		HEX2 = segtim_2.oSEG;
		HEX1 = segtim_1.oSEG;
		HEX0 = segtim_0.oSEG;
	}
	instruct nes.tim_sq1 segtim_3.run();
	instruct nes.tim_sq2 segtim_2.run();
	instruct nes.tim_tri segtim_1.run();
	instruct nes.tim_noi segtim_0.run();

	SDRAM_CSn = sdram.CSn;
	SDRAM_RASn = sdram.RASn;
	SDRAM_CASn = sdram.CASn;
	SDRAM_WEn = sdram.WEn;
	SDRAM_DEn = sdram.DEn;
	SDRAM_BA = sdram.BA;
	SDRAM_ADDR = sdram.A;
	SDRAM_LDQM = sdram.LDM;
	SDRAM_UDQM = sdram.HDM;
	SDRAM_Dout = sdram.Dout;
	sdram.Din = SDRAM_Din;

	SD_CSn = sdcard.CSn;
	SD_CLK = sdcard.CLK;
	SD_CMD = sdcard.CMD;
	sdcard.DAT = SD_DAT;

	instruct fat.sread sdcard.read(fat.sadrs);
	fat.sack = sdcard.ack;
	fat.sdata = sdcard.rdata;

	kb.ps2Clk = PS2_KBCLK;
	kb.ps2Data = PS2_KBDAT;

	instruct vga.nes_vsync wave.vsync();
	wave.sound = nes.sound_L;
/*
	vga.vt_su = 2;
	vga.vt_vu = 2 + 33;
	vga.vt_nu = 2 + 33 + 16 - 2;
	vga.vt_nd = 2 + 33 + 480 - 16 - 2;
	vga.vt_vd = 2 + 33 + 480;
	vga.vt_sd = 525 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 48;
	vga.ht_nu = 96 + 48 + 64;
	vga.ht_nd = 96 + 48 + 64 + 512;
	vga.ht_vd = 96 + 48 + 640;
	vga.ht_sd = 800 - 1;
*/
// V525ラインにするとH792になって描画がオーバーする
// VGA 640x480 ドットクロック 25.0MHz Vライン524 フレームレート60.0988 Hzを実現するためのHタイミングについて計算してください。Vタイミングについてもついでに教えてください。
// 約60.0988Hz cpu_timing_test ok
/*
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32;
	vga.vt_nu = 2 + 32 + 16 - 1;
	vga.vt_nd = 2 + 32 + 480 - 16 - 1;
	vga.vt_vd = 2 + 32 + 480;
	vga.vt_sd = 524 - 1;
*/
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32 - 1;
	vga.vt_nu = 2 + 32 - 1;
	vga.vt_nd = 2 + 32 + 480 - 1;
	vga.vt_vd = 2 + 32 + 480 - 1;
	vga.vt_sd = 524 - 1;

	vga.ht_su = 96;
	vga.ht_vu = 96 + 42;
	vga.ht_nu = 96 + 42 + 64;
	vga.ht_nd = 96 + 42 + 64 + 512;
	vga.ht_vd = 96 + 42 + 640;
	vga.ht_sd = 794 - 1;

	if(vga.win_valid){
		if(^mmc.supported){
			VGA_R_reg := 0b0101;
			VGA_G_reg := 0b0001;
			VGA_B_reg := 0b0001;
		}
		else{
			if(mmc.f_nsf){
				// 波形表示
				wave.read(vga.hcount, vga.vcount);
				VGA_R_reg := wave.r_out<4:1>;
				VGA_G_reg := wave.g_out<4:1>;
				VGA_B_reg := wave.b_out<4:1>;
			}
			else{
				VGA_R_reg := dis.r_out;
				VGA_G_reg := dis.g_out;
				VGA_B_reg := dis.b_out;
			}
		}
	}
	else{
		// NES画面外の色（ディスプレイ自動幅調整のため）
		VGA_R_reg := 0b0001;
		VGA_G_reg := 0b0001;
		VGA_B_reg := 0b0001;
	}
	reg_wr VGA_HS_reg, VGA_VS_reg;
	VGA_HS_reg := vga.hsync; VGA_HS = VGA_HS_reg;
	VGA_VS_reg := vga.vsync; VGA_VS = VGA_VS_reg;
//	VGA_R_reg := red_out_reg & (4#vga.view_valid); VGA_R = VGA_R_reg;
//	VGA_G_reg := grn_out_reg & (4#vga.view_valid); VGA_G = VGA_G_reg;
//	VGA_B_reg := blu_out_reg & (4#vga.view_valid); VGA_B = VGA_B_reg;
	VGA_R = VGA_R_reg;
	VGA_G = VGA_G_reg;
	VGA_B = VGA_B_reg;

	LCD_RS = lcd.rs;
	LCD_RW = lcd.rw;
	LCD_EN = lcd.en;
	LCD_DATA = lcd.data;

	nes.f_real_cartridge = 0b0;
	nes.IRQn = mmc.IRQn;
	nes.VRAM_CSn = mmc.VRAM_CSn;
	nes.VRAM_A10 = mmc.VRAM_A10;
	if(^prg_read_ok) nes.ready();

//	if(^SW<7>) nes.sw_apu_stereo();
	if(SW<8>) nes.sw_slow();
	if(SW<9>) nes.sw_stop();
	nes.f_nsf = mmc.f_nsf;
	instruct mmc.NMI_out nes.nsf_NMI();

	mmc.mapper_enable = mapper_enable.enable;

	if(^prg_read_ok) mmc.ready();
//	instruct nes.clk_out mmc.Phi();

	reg_wr cnt_1MHz<6>;
	if(cnt_1MHz==50){
		mmc.tim1MHz();
		cnt_1MHz := 1;
	}
	else cnt_1MHz++;

	mmc.fat_eof = fat.eof;

#ifdef VRC7
	mmc.mute = SW<9:3>;
#else
	mmc.mute = SW<9:3> | 0b0000001;
#endif
	mmc.nes_sound_L = nes.sound_L;
	mmc.nes_sound_R = nes.sound_R;

	any{
		mmc.sound_L<14> : sound_L_clip = -1;
		else : sound_L_clip = mmc.sound_L<13:0>;
	}
	any{
		mmc.sound_R<14> : sound_R_clip = -1;
		else : sound_R_clip = mmc.sound_R<13:0>;
	}
	if(SW<1>){ // 逆位相サラウンド
		sound_L = sound_L_clip + 0b10000000000000; // 加算でプチノイズが消える
		sound_R = -(sound_R_clip + 0b10000000000000);
	}
	else{
		sound_L = sound_L_clip;
		sound_R = sound_R_clip;
	}
	dac_L.din = sound_L || 0b00;
	dac_R.din = sound_R || 0b00;
	Sound_Left  = dac_L.dout;
	Sound_Right = dac_R.dout;

	reg_wr tas_key<8>;
	// NESPAD : 右|左|下|上|ｽﾀｰﾄ|ｾﾚｸﾄ|B|A
//	nes.pad1P = (btn_1 & ^btn_2) || 0b000 || (btn_2 & btn_1) || 0b00 || btn_2;
	nes.pad1P =
		((btn_1 || SW<4:2> || SW<0> || 0b0 || SW<1> || btn_2) & 8#(mmc.f_nes & prg_read_ok)) |
		(keys[0x74] || keys[0x6B] || keys[0x72] || keys[0x75] || keys[0x5A] || keys[0x29] || keys[0x1A] || keys[0x22]) |
		tas_key;
	nes.pad2P = 0x00;

	LEDG = (0b00 || nes.pad1P) |
		(dac_sq1.DACout || dac_sq2.DACout || dac_tri.DACout || dac_noi.DACout || dac_dmc.DACout ||
		 dac_mmc5.DACout || dac_n106.DACout || dac_fds.DACout || dac_vrc6.DACout || (dac_sn5b.DACout | dac_vrc7.DACout));

	// ソフトリセット
	if(/&nes.pad1P<3:2>){
		nes.soft_reset();
		mmc.soft_reset();
	}

	any{
		btn_2 : seg = nes.dbg;
		btn_1 : ;
		/|nes.halt_code : seg = 0x00 || nes.halt_code;
		else : seg = nes.pc_out;
	}

	if(mmc.f_nsf) alt{
		btn_2 : par{ // 進む
			generate key_seek.next();
		}
		btn_1 : par{ // 戻る
			generate key_seek.back();
		}
	}

	mmc.ROM_SELn = nes.ROM_SELn;
	mmc.prg_A = nes.prg_A;
	instruct nes.prg_read mmc.prg_read();
	nes.prg_Dout = mmc.prg_Dout;
	instruct mmc.prg_ack nes.prg_ack();

	mmc.prg_Din = nes.prg_Din;
	instruct nes.prg_write mmc.prg_write();

	mmc.chr_A = nes.chr_PA;
	instruct nes.chr_read par{
		// romセット時にchr_rom読み込み防止
		if(prg_read_ok) mmc.chr_read();
	}
	nes.chr_PDout = mmc.chr_Dout;
	instruct mmc.chr_ack nes.chr_ack();

	mmc.chr_Din = nes.chr_PDin;
	instruct nes.chr_write mmc.chr_write();

	// SDRAM1個でPRG-ROMとCHR-ROMを共有する
	reg_wr prg_read_wait, prg_read_ack_wait;
	reg_wr chr_read_wait, chr_read_ack_wait;
	reg_wr chr_write_wait, chr_write_ack_wait;

	// PRG-ROM readは、CHR-ROMアクセス発行と同時だったらこちら優先だが、
	// すでにCHR-ROMアクセス時なら終了待ち、ack必要。
	if( (mmc.prg_mem_read | prg_read_wait) & 
		^chr_read_ack_wait & ^chr_write_ack_wait & sdram.ack){
		sdram.read(0b000 || mmc.prg_mem_adrs);
		prg_read_wait := 0b0;
		prg_read_ack_wait := 0b1;
	}
	else if(mmc.prg_mem_read) prg_read_wait := 0b1;
	if(prg_read_ack_wait & sdram.ack){
		mmc.prg_mem_ack();
		prg_read_ack_wait := 0b0;
	}
	mmc.prg_mem_dout = sdram.dout;

	// PRG-ROM writeは、ROM読み込み時のみなので排他処理不要。
	if(mmc.prg_mem_write){
		sdram.write(0b000 || mmc.prg_mem_adrs, mmc.prg_mem_din);
	}

	// CHR-ROM readは、PRG-ROM readアクセス終了待ち、ack必要。
	if( (mmc.chr_mem_read | chr_read_wait) &
		^mmc.prg_mem_read & ^prg_read_ack_wait & sdram.ack){
		sdram.read(0b0010 || mmc.chr_mem_adrs);
		chr_read_wait := 0b0;
		chr_read_ack_wait := 0b1;
	}
	else if(mmc.chr_mem_read) chr_read_wait := 0b1;
	if(chr_read_ack_wait & sdram.ack){
		mmc.chr_mem_ack();
		chr_read_ack_wait := 0b0;
	}
	mmc.chr_mem_dout = sdram.dout;

	// CHR-RAM writeは、PRG-ROM readアクセス終了待ち、ack不要。
	if( (mmc.chr_mem_write | chr_write_wait) &
		^mmc.prg_mem_read & ^prg_read_ack_wait & sdram.ack){
		sdram.write(0b0010 || mmc.chr_mem_adrs, mmc.chr_mem_din);
		chr_write_wait := 0b0;
		chr_write_ack_wait := 0b1;
	}
	else if(mmc.chr_mem_write) chr_write_wait := 0b1;
	if(chr_write_ack_wait & sdram.ack){
		chr_write_ack_wait := 0b0;
	}


	instruct nes.VIDEO_enable par{
		dis.write(nes.video);
	}

	instruct nes.note_sq1 if(^mmc.mute<6>) note_sq1 := 0b1111111;
	instruct nes.note_sq2 if(^mmc.mute<6>) note_sq2 := 0b1111111;
	instruct nes.note_tri if(^mmc.mute<6>) note_tri := 0b1111111;
	instruct nes.note_noi if(^mmc.mute<6>) note_noi := 0b1111111;
	instruct nes.note_dmc if(^mmc.mute<6>) note_dmc := 0b1111111;
	instruct mmc.note_mmc5 if(^mmc.mute<5>) note_mmc5 := 0b1111111;
	instruct mmc.note_n106 if(^mmc.mute<4>) note_n106 := 0b1111111;
	instruct mmc.note_fds  if(^mmc.mute<3>) note_fds  := 0b1111111;
	instruct mmc.note_vrc6 if(^mmc.mute<2>) note_vrc6 := 0b1111111;
	instruct mmc.note_sn5b if(^mmc.mute<1>) note_sn5b := 0b1111111;
	instruct mmc.note_vrc7 if(^mmc.mute<0>) note_vrc7 := 0b1111111;
	note_count++;
	if(/&note_count){
		if(note_sq1!=0) note_sq1--;
		if(note_sq2!=0) note_sq2--;
		if(note_tri!=0) note_tri--;
		if(note_noi!=0) note_noi--;
		if(note_dmc!=0) note_dmc--;
		if(note_mmc5!=0) note_mmc5--;
		if(note_n106!=0) note_n106--;
		if(note_fds!=0)  note_fds--;
		if(note_vrc6!=0) note_vrc6--;
		if(note_sn5b!=0) note_sn5b--;
		if(note_vrc7!=0) note_vrc7--;
	}
	dac_sq1.DACin = note_sq1;
	dac_sq2.DACin = note_sq2;
	dac_tri.DACin = note_tri;
	dac_noi.DACin = note_noi;
	dac_dmc.DACin = note_dmc;
	dac_mmc5.DACin = note_mmc5;
	dac_n106.DACin = note_n106;
	dac_fds.DACin = note_fds;
	dac_vrc6.DACin = note_vrc6;
	dac_sn5b.DACin = note_sn5b;
	dac_vrc7.DACin = note_vrc7;

	reg_wr clock25M_div;
	clock25M_div := ^clock25M_div;
	if(clock25M_div /*& prg_read_ok*/) vga.run();

	instruct vga.dis par{
		if(dis_timing) dis.read();
		dis_timing := ^dis_timing;
	}

	instruct vga.nes_hsync par{
		dis.bank_change();
		generate nes_line.do();
	}

	instruct dds_ntsc.run par{ // 5.369318MHz
		if(prg_read_ok /*& ^mmc.f_nsf_PAL*/){
			nes.run();
		}
	}

	instruct nes.clk_out par{
		mmc.clock1789k();
	}
/*
	instruct dds_pal_clk.run par{
		if(prg_read_ok & mmc.f_nsf_PAL){
			nes.run();
		}
	}
*/

	instruct vjtag.recv par{
		generate vjtag2ram.do();
	}

	stage clock3580k {
		reg clock3580k_count<4> = 1;
		par{
			if(clock3580k_count==14){
				if(prg_read_ok){
					mmc.clock3580k();
				}
				clock3580k_count := 1;
			}
			else clock3580k_count++;
			if(0b0) finish; // 未使用
		}
	}

	stage nes_line {
		reg pixel_count<9> = 1;
		reg cpu_timing<3> = 0b001;
		par{
			if(dds_ntsc.run){

				nes.draw();

				// mmcには描画に合わせたクロックを入れてみる
				if(cpu_timing<0>) mmc.Phi();
				cpu_timing := cpu_timing<1:0> || cpu_timing<2>;

				if(pixel_count==341){
					nes.hblank();
					pixel_count := 1;
				//	cpu_timing := 0b001;
					finish;
				}
				else{
					pixel_count++;
				//	cpu_timing := cpu_timing<1:0> || cpu_timing<2>;
				}
			}
		}
	}

	stage key2btn {
		reg_ws push;
		par{
			if(kb.scanok) switch(kb.scancode){
				case 0xE0: ; // 無視
				case 0xF0: push := 0b0;
				default: par{
					keys[kb.scancode<6:0>] := push;
					push := 0b1;
				}
			}
			if(0b0) finish;
		}
	}

	stage key_seek {
		first_state iwait;
		state iwait par{
			prg_read_ok := 0b0;
			goto st1;
		}
		state st1 par{
			any{
				key_seek.next : file_num++;
				key_seek.back : file_num--;
			}
			generate card2ram.do();
			goto st2;
		}
		state st2 if(^card2ram.do){
			if((key_seek.next & (^btn_2))
			 | (key_seek.back & (^btn_1))){
				goto iwait;
				finish;
			}
		}
	}

	stage card2ram {
		first_state st_begin;
		state st_begin if(fat.ack){
			prg_read_ok := 0b0;
			fat.fopen(file_num);
			goto st_fatr;
		}
		state st_fatr if(fat.ack){
			fat.read();
			goto st_head;
		}
		state st_head if(fat.ack){
			mmc.set_head(fat.fdata);
			fat.read();
			if(mmc.head_err){
				any{
					key_seek.next : file_num++;
					key_seek.back : file_num--;
					else : file_num++;
				}
				goto st_begin;
			}
			if(mmc.head_ok) goto st_reopen;
		}
		state st_reopen if(fat.ack){
			nes.mem_clear();
			fat.fopen(file_num);
			goto st_attach;
		}
/*
		state st_attach if(fat.ack & mmc.attach_ack & sdram.ack){
			//if(^fat.eof)
			 fat.read();
			mmc.attach(fat.fdata);
			if(mmc.set_ok) goto st_end;
		}
*/
		state st_attach if(fat.ack & mmc.attach_ack & sdram.ack){
			//if(^fat.eof)
			 fat.read();
			mmc.attach(fat.fdata);
			if(^mmc.f_BatteryBackup & mmc.set_ok) goto st_end;
			if(mmc.f_BatteryBackup & fat.eof) goto st_open_save;
		}
		state st_open_save if(fat.ack){
			fat.fopen(file_num+1);
			goto st_read_save;
		}
		state st_read_save if(fat.ack){
			fat.read();
			goto st_write_save;
		}
		state st_write_save if(fat.ack & mmc.attach_ack){
			fat.read();
			mmc.attach(fat.fdata);
			if(mmc.set_ok) goto st_end;
		}

		state st_end if(sdram.ack){
			nes.soft_reset();
			mmc.soft_reset();
			prg_read_ok := 0b1;
		//	generate prg_set_wait.do();
		//	generate tas_stg.do();
			goto st_begin;
			finish;
		}
	}

	stage tas_stg {
		reg_wr tas_file_type<3>;
		mem tas_buf[32];
		first_state st_open;
		state st_open if(fat.ack){
			fat.fopen(file_num + 1);
			goto st_type;
		}
		state st_type if(fat.ack){
			fat.read();
			if(fat.fdata=='['){ // bk2
				tas_file_type := 3;
				goto st_head;
			}
			if(fat.fdata=='v'){ // fm2
				tas_file_type := 4;
				goto st_head;
			}
		}
		state st_head if(fat.ack){
			fat.read();
			if(fat.fdata==0x0A){ // \n
				reg_wr lf_count<4>;
				if((tas_file_type==3) & (lf_count== 1)) goto st_input;
				if((tas_file_type==4) & (lf_count==13)) goto st_input;
				lf_count++;
			}
		}
		state st_input if(fat.ack){
			reg_wr buf_i<5>;
			tas_buf[buf_i] := fat.fdata!='.';
			fat.read();
			if(fat.fdata==0x0A){ // \n
				buf_i := 0;
				goto st_key;
			}
			else buf_i++;
			if(fat.eof) finish; // TAS end
		}
		state st_key if(vga.nes_vsync){
			// Pad 右|左|下|上|ｽﾀｰﾄ|ｾﾚｸﾄ|B|A
			if(tas_file_type==3){
				tas_key :=
					tas_buf[ 7] || // Right
					tas_buf[ 6] || // Left
					tas_buf[ 5] || // Down
					tas_buf[ 4] || // Up
					tas_buf[ 8] || // Start
					tas_buf[ 9] || // Select
					tas_buf[10] || // B
					tas_buf[11];   // A
			}
			if(tas_file_type==4){
				tas_key :=
					tas_buf[ 3] || // Right
					tas_buf[ 4] || // Left
					tas_buf[ 5] || // Down
					tas_buf[ 6] || // Up
					tas_buf[ 7] || // Start
					tas_buf[ 8] || // Select
					tas_buf[ 9] || // B
					tas_buf[10];   // A
			}
			goto st_input;
		}
	}

	stage vjtag2ram {
		first_state st_begin;
		finish;
		state st_begin par{
			prg_read_ok := 0b0;
			nes.mem_clear();
			mmc.set_type(vjtag.recv_data); // R(ROM),S(NSF),P(Pad)
			goto st_attach;
		}
		state st_attach par{
			mmc.attach(vjtag.recv_data);
			if(mmc.set_ok) goto st_end;
		}
		state st_end par{
			nes.soft_reset();
			mmc.soft_reset();
		//	prg_read_ok := 0b1;
			generate prg_set_wait.do();
			goto st_begin;
		}
	}

	stage prg_set_wait {
		reg_wr pwait<4>;
		par{
			pwait++;
			if(/&pwait){
				prg_read_ok := 0b1;
				finish;
			}
		}
	}

	stage lcd_view {
		reg_wr str_view_reg<256>;
		reg_wr lw_count<26>, chr_shift<5>;
		first_state st1;
		par{
			lcd.str0 = str_view_reg<255:128>;
			lcd.str1 = mmc.artist_str;
			if(0b0) finish;
		}
		state st1 if(lcd.ack & prg_read_ok){
			str_view_reg := mmc.title_str;
			lcd.view_on();
			lw_count := 0;
			chr_shift := 0;
			if(mmc.title_length<4> & /|mmc.title_length<3:0>) goto st1w;
		}
		state st1w par{
			lw_count++;
			if(/&lw_count) goto st2;
			if(^prg_read_ok) goto st1;
		}
		state st2 if(lcd.ack){
			if(lw_count==20000000){
				str_view_reg := str_view_reg<247:0> || ' ';
				lcd.view_on();
				lw_count := 0;
				chr_shift++;
				if(chr_shift==mmc.title_length) goto st1;
			}
			else lw_count++;
			if(^prg_read_ok) goto st1;
		}
	}

}
