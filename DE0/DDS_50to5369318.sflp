/*
 50MHzから約5,369,318Hzを生成する
 カウンタ 26bit、加算値 2684659、最大値 25000000、誤差 0.0000000000
*/

%d COUNT_WIDTH 26

circuit DDS_50to5369318
{
	instrout run;

	sel add<COUNT_WIDTH>;
	sel max<COUNT_WIDTH>;
	reg_wr count<COUNT_WIDTH>;
	sel sa<COUNT_WIDTH>;

	add = 2684659;
	max = 25000000;

	sa = count - max;

	if(sa<COUNT_WIDTH-1>){ // count < max
		count += add;
	}
	else{
		count := sa + add;
		run();
	}
}
