
// Nintendo Entertainment System core

%i "cpu/MPU6502.h"
%i "ppu/ppu_core.h"
%i "ppu/PictureProcessingUnit.h"
%i "ppu/PictureProcessingUnit_spr16.h"
%i "apu/AudioProcessingUnit.h"
%i "mem/ram_8x2k.h"

circuit NintendoEntertainmentSystem
{
	// PRG-ROM EXT-ROM EXT-RAM
	output prg_A<15>, ROM_SELn, RW, prg_RW, Phi2;
	reg prg_A_reg<16>, Phi2_reg;
	reg_ws RW_reg, prg_RW_reg;
	input IRQn;
	input prg_Dout<8>;
	reg prg_Dout_reg<8>;
	output prg_Din<8>;
	instrin prg_ack;

	// CHR-ROM
	output chr_PA<14>, WEn, RDn, chr_RW;
	reg_ws WEn_reg, RDn_reg, chr_RW_reg;

	input VRAM_CSn, VRAM_A10;
	input chr_PDout<8>;
	reg chr_PDout_reg<8>;
	output chr_PDin<8>;
	instrin chr_ack;

	input pad1P<8>, pad2P<8>;
	instrin sw_apu_stereo;

	instrin soft_reset, mem_clear, ready;
	instrin run, draw, hblank;
	instrout clk_out;

	// Mapper用
	instrout prg_read, prg_write;
	instrout chr_read, chr_write;

	// VIDEO
	output video<6>;
	instrout VIDEO_enable;

	input mute<5>, f_volume_boost<5>;
	output sound_L<8>, sound_R<8>, volume_boost<8>;
	instrout note_sq1, note_sq2, note_tri, note_noi, note_dmc;
	instrout tim_sq1, tim_sq2, tim_tri, tim_noi;

	MPU6502 cpu;
	PictureProcessingUnit ppu;
	AudioProcessingUnit apu;
	ram_8x2k vmem, wmem;
	instrout mem_cleaned;

	reg_ws reset;
	reg cpu_timing<3>;
	reg_wr io_reg<8>;
	reg_wr pad1_data<8>, pad2_data<8>;
	instrself map_wmem, map_ppu, map_nesrom, map_apu;

	reg cpu_dout_reg<8>;
	reg_wr prg_count<5>, chr_count<4>;

	// DMA
	reg_wr f_dma_do, dma_data<8>;
	reg_wr f_apu_dmc, apu_dmc_adrs<16>;

	// 実カートリッジ使用
	input f_real_cartridge;
	// 25MHz用
	instrin f_25MHz;

	reg_wr sp_flag;
	reg_wr pre_nmi;

	// NSF拡張
	input f_nsf;
	instrin nsf_NMI;
	reg_wr nsf_nmi_reg;

	instrself halt(h_code);
	sel h_code<8>;
	reg_wr halt_code_reg<8>;
	output halt_code<8>;

	// Debug
output ir_out<8>, pc_out<16>, ir_sync;
//	instrout trace_ir;
	instrin sw_slow, sw_stop;
output dbg<16>;
reg_wr dbg_reg<16>;

	stage_name cpu_read { task do(prg_A_reg); }
	stage_name io_read_wait { task do(); }
	stage_name prg_read_stg { task do(); }
	stage_name prg_read_ack_wait { task do(); }
	stage_name cpu_write { task do(prg_A_reg, cpu_dout_reg); }
	stage_name prg_write_stg { task do(); }
	stage_name vram_read_stg { task do(); }
	stage_name chr_read_stg { task do(); }
	stage_name chr_read_ack_wait { task do(); }
	stage_name vram_write_stg { task do(); }
	stage_name chr_write_stg { task do(); }
	stage_name chr_write_ack_wait { task do(); }
	stage_name phi2_tim { task do(); }
	stage_name dma_run { task do(); }
	stage_name dma_read_wait { task do(); }
	stage_name apu_dmc_read { task do(); }
	stage_name apu_dmc_read_wait { task do(); }
	stage_name mem_clear_stg { task do(); }

	if(reset){
		cpu_timing := 0b001;
		reset := 0b0;
	}

	instruct soft_reset par{
		reset := 0b1;
		cpu.soft_reset();
		apu.ready();
		ppu.soft_reset();
		f_dma_do := 0b0;
		f_apu_dmc := 0b0;
	//	pre_nmi := 0b0;
		nsf_nmi_reg := 0b0;
	}

	instruct mem_clear par{
		generate mem_clear_stg.do();
		ppu.spr_ram_clear();
	}

	instruct halt halt_code_reg := h_code;
	halt_code = halt_code_reg | /*cpu.halt_code |*/ ppu.halt_code;

	any{
		prg_A_reg<15:13>==0b000 : par{ // $0000-$07FF WRAM
			map_wmem();
		}
		prg_A_reg<15:13>==0b001 : par{ // $2000-$2007 PPU
			map_ppu();
		}
		prg_A_reg<15:13>==0b010 : any{
			prg_A_reg<12:5>==0b00000000 : par{ // $4000-$401F APU, PAD
				map_apu();
			}
			else : par{ // $4020-$5FFF ExROM
				map_nesrom();
			}
		}
		prg_A_reg<15:13>==0b011 : par{ // $6000-$7FFF ExRAM
			map_nesrom();
		}
		prg_A_reg<15> : par{ // $8000-$FFFF ROM
			map_nesrom();
		}
	}

	any{
		map_wmem : cpu.din = wmem.dout;
		map_ppu  : cpu.din = ppu.Dout;
		map_apu  : cpu.din = io_reg;
		map_nesrom : par{
			if(f_real_cartridge) cpu.din = prg_Dout_reg;
			else cpu.din = prg_Dout;
		}
	}

	prg_A = prg_A_reg<14:0>;
	ROM_SELn = ^prg_A_reg<15>;
	RW = RW_reg;
	prg_RW = prg_RW_reg;
	prg_Din = cpu_dout_reg;
	Phi2 = Phi2_reg;

	chr_PA = ppu.PA;
	WEn = WEn_reg;
	RDn = RDn_reg;
	chr_RW = chr_RW_reg;
	if(VRAM_CSn==0b0) ppu.PDin = vmem.dout;
	else{
		if(f_real_cartridge) ppu.PDin = chr_PDout_reg;
		else ppu.PDin = chr_PDout;
	}
	chr_PDin = ppu.PDout;

	instruct sw_apu_stereo apu.sw_stereo();
	apu.dpcm_7bit = 0b1;
	apu.mute = mute;
	sound_L = apu.sound_L;
	sound_R = apu.sound_R;
	apu.f_volume_boost = f_volume_boost;
	volume_boost = apu.volume_boost;

	if(f_nsf){ // 60Hz以外のNSF用拡張
/*
		// 捕まえきれない DMC IRQで遅くなる
		if(nsf_NMI & ppu.f_nmi_en){
			if(sp_flag & ^sw_stop & ^ready) cpu.NMI();
			if(sw_slow) sp_flag := ^sp_flag;
		}
*/
		if(nsf_NMI){
			if(sp_flag & ^sw_stop & ^ready) nsf_nmi_reg := 0b1;
			if(sw_slow) sp_flag := ^sp_flag;
		}
		if(nsf_nmi_reg & ppu.f_nmi_en){
			if(apu.IRQn==0b1) cpu.NMI();
			nsf_nmi_reg := 0b0;
		}
	}
	else{
		// 立上りのみ
		pre_nmi := ppu.o_NMI;
		if((pre_nmi || ppu.o_NMI)==0b01){
			if(sp_flag & ^sw_stop & ^ready) cpu.NMI();
			if(sw_slow) sp_flag := ^sp_flag;
		}
	}

	cpu.IRQn = IRQn & apu.IRQn;

	// debug
	ir_out = cpu.ir_out;
	pc_out = cpu.pc_out;
	ir_sync = cpu.ir_sync;

	if(^sw_slow) sp_flag := 0b1;

//dbg = cpu.dbg || apu.dbg;
dbg = dbg_reg | (0x00 || ppu.dbg);

/*
	instruct cpu.trace_ir par{
		trace_ir();
	}
*/

	instruct run if(halt_code==0x00){
//if(mem_clear_stg.do) halt(0x6);

		if(cpu_timing<0>){ // 約1.789MHz
			alt{
				f_apu_dmc : generate apu_dmc_read.do();
				f_dma_do  : generate dma_run.do();
				else      : cpu.run();
			}

			apu.run();
			apu.dmc_clock();

			clk_out();
			generate phi2_tim.do();
		}
		cpu_timing := cpu_timing<1:0> || cpu_timing<2>;
	}

	instruct cpu.read_req par{
		generate cpu_read.do(cpu.A);
	}

	instruct cpu.write_req par{
		generate cpu_write.do(cpu.A, cpu.dout);
	}

	// PPU 外部入力
	instruct draw ppu.draw();
	instruct hblank ppu.hblank();

	instruct ppu.chr_read_req par{
		if(f_real_cartridge){
			generate vram_read_stg.do();
			generate chr_read_stg.do();
		}
		else{
			if(f_25MHz){
				if(VRAM_CSn==0b0){
					vmem.read(VRAM_A10 || ppu.PA<9:0>);
				}
				chr_read(); // for Mappers
			}
			generate chr_read_ack_wait.do();
		}
//if(chr_read_stg.do) halt(0x12);
//if(chr_write_stg.do) halt(0x13);
	}

	instruct ppu.chr_write_req par{
		if(f_real_cartridge){
			generate vram_write_stg.do();
			generate chr_write_stg.do();
		}
		else{
			if(f_25MHz){ // TangNano9Kで必要
				if(VRAM_CSn==0b0){
					vmem.write(VRAM_A10 || ppu.PA<9:0>, ppu.PDout);
				}
				chr_write(); // for Mappers
			}
			else generate chr_write_ack_wait.do();
		}
//if(chr_read_stg.do) halt(0x22);
//if(chr_write_stg.do) halt(0x23);
	}

	// PPU 外部出力
	instruct ppu.VIDEO_enable par{
		video = ppu.VIDEO;
		VIDEO_enable();
	}

	instruct apu.dmc_read par{
		apu_dmc_adrs := apu.dmc_adrs;
		f_apu_dmc := 0b1;
	}

	instruct apu.sq1_note_on note_sq1();
	instruct apu.sq2_note_on note_sq2();
	instruct apu.tri_note_on note_tri();
	instruct apu.noi_note_on note_noi();
	instruct apu.dmc_note_on note_dmc();

	instruct apu.sq1_tim tim_sq1();
	instruct apu.sq2_tim tim_sq2();
	instruct apu.tri_tim tim_tri();
	instruct apu.noi_tim tim_noi();

	stage cpu_read {
		par{
			any{
				map_wmem : par{
					wmem.read(prg_A_reg<10:0>);
					generate io_read_wait.do();
				}
				map_ppu : par{
					ppu.io_read(prg_A_reg<2:0>);
					generate io_read_wait.do();
				}
				map_apu : par{
					any{
						prg_A_reg<4:0>==0b10110 : par{ // $4016
							io_reg := 0b0000000 || pad1_data<0>;
							pad1_data >>= 1;
						}
						prg_A_reg<4:0>==0b10111 : par{ // $4017
							io_reg := 0b0000000 || pad2_data<0>;
							pad2_data >>= 1;
						}
						else : io_reg := apu.io_read(prg_A_reg<4:0>).dout;
					}
					generate io_read_wait.do();
				}
				map_nesrom : par{
					if(f_real_cartridge) ;//generate prg_read_stg.do();
					else{
						prg_read(); // for Mappers
						generate prg_read_ack_wait.do();
					}
				}
			}
			if(f_real_cartridge) generate prg_read_stg.do();
			finish;
		}
	}

	stage io_read_wait {
		if(map_wmem | (map_ppu & ppu.io_ack) | map_apu){
			cpu.read_ack();
			finish;
		}
	}

	// 50MHz/1.789772.5 = 27.9
// OEnを使うとchrにノイズがちょっとのる?
	stage prg_read_stg {
		first_state st1;
		state st1 par{
			prg_RW_reg := 0b1;
			prg_count := 0;
			goto st1w;
		}
		state st1w par{
			RW_reg := 0b1;
			goto st2;
		}
		state st2 par{
			prg_count++;
// 16 ok
			if(prg_count==16) goto st3;
		}
		state st3 par{
			prg_Dout_reg := prg_Dout;
			goto st4;
		}
		state st4 par{
			cpu.read_ack();
			goto st1;
			finish;
		}
	}

	// Mapper用
	stage prg_read_ack_wait {
		if(prg_ack | ready){
			cpu.read_ack();
			finish;
		}
	}

	stage cpu_write {
		par{
			any{
				map_wmem : par{
					wmem.write(prg_A_reg<10:0>, cpu_dout_reg);
				}
				map_ppu : par{
					ppu.io_write(prg_A_reg<2:0>, cpu_dout_reg);
				}
				map_apu : any{
					prg_A_reg<4:0>==0b10100 : par{ // $4014
						f_dma_do := 0b1;
					}
					prg_A_reg<4:0>==0b10110 : par{ // $4016
						pad1_data := pad1P;
						pad2_data := pad2P;
					}
					else : apu.io_write(prg_A_reg<4:0>, cpu_dout_reg);
				}
				map_nesrom : par{
					if(f_real_cartridge);// generate prg_write_stg.do();
					else{
						// ミネルバトンサーガ用(カセットへのセーブしないように)
						//if(A_reg<15:4>==0x7EF) mapperで処理してるか要確認
					//	generate prg_write_stg.do();
						prg_write(); // for Mappers
					}
				}
			}
			if(f_real_cartridge) generate prg_write_stg.do();
			finish;
		}
	}

// レベルセンシティブではなさそう
// RWの立ち上がりっぽい
	stage prg_write_stg {
		first_state st1;
		state st1 par{
			prg_RW_reg := 0b0;
			prg_count := 0;
			goto st1w;
		}
		state st1w par{
			prg_count++;
// 3 ok
// 4 ok
			if(prg_count==3) goto st1ww;
		}
		state st1ww par{
			RW_reg := 0b0;
			prg_count := 0;
			goto st2;
		}
		state st2 par{
			prg_count++;
// 12 ok
// 14 ok
// 22 NG
			if(prg_count==14) goto st3;
		}
		state st3 par{
			RW_reg := 0b1;
			goto st4;
		}
		state st4 par{
			prg_RW_reg := 0b1;
			goto st1;
			finish;
		}
	}

//	DMA中にAPUのDMC読み込みの可能性があるためread_waitが必要。
//	DMAは513サイクル必要。
	stage dma_run {
		reg_wr dma_adrs_low<8>;
		first_state st_dma_read;
		finish;
		state st_dma_read par{
			generate cpu_read.do(cpu_dout_reg || dma_adrs_low);
			generate dma_read_wait.do();
			goto st_dma_write;
		}
		state st_dma_write par{
			ppu.io_write(0b100, dma_data); // $2004
			if(/&dma_adrs_low) f_dma_do := 0b0;
			dma_adrs_low++;
			goto st_dma_read;
		}
	}

	// DMA中にDMC_readが入る可能性があるのでこれが必要
	stage dma_read_wait {
		if(cpu.read_ack){
			dma_data := cpu.din;
			finish;
		}
	}

	// カートリッジ用
	// リターンバック 7 + 10.5 = 17.5ns
	stage vram_read_stg {
		first_state st1;
		state st1 goto st2;	// リターンバック信号待ち1
		state st2 goto st3;	// リターンバック信号待ち2
		state st3 goto st4;	// リターンバック信号待ち3
		state st4 par{
			if(VRAM_CSn==0b0){
				vmem.read(VRAM_A10 || ppu.PA<9:0>);
			}
			goto st1;
			finish;
		}
	}

	// 50MHz: 18 cycle (17でマリオok,3NG)
	stage chr_read_stg {
		first_state st1;
		state st1 par{
			chr_RW_reg := 0b1;
			chr_count := 0;
			goto st2;
		}
		state st2 par{
			chr_count++;
			if(chr_count==3) goto st3;
		}
		state st3 par{
			RDn_reg := 0b0;
			chr_count := 0;
			goto st4;
		}
		state st4 par{
// 7 ノイズ出る
// 8 ok
			chr_count++;
			if(chr_count==8) goto st5;
		}
		state st5 par{
			chr_PDout_reg := chr_PDout;
			goto st6;
		}
		state st6 par{
			RDn_reg := 0b1;
			ppu.chr_read_ack();
			goto st1;
			finish;
		}
	}

	// Mapper用
	stage chr_read_ack_wait {
		first_state st1;
		state st1 par{
			if(^f_25MHz){
				if(VRAM_CSn==0b0){
					vmem.read(VRAM_A10 || ppu.PA<9:0>);
				}
				chr_read(); // for Mappers
				goto st2;
			}
			else{ // DE0_25MHzで必要
				if((VRAM_CSn==0b0) | chr_ack | ready){
					ppu.chr_read_ack();
					finish;
				}
			}
		}
		state st2 if((VRAM_CSn==0b0) | chr_ack | ready){
			ppu.chr_read_ack();
			goto st1;
			finish;
		}
	}

	// カートリッジ用
	stage vram_write_stg {
		first_state st1;
		state st1 goto st2;	// リターンバック信号待ち1
		state st2 goto st3;	// リターンバック信号待ち2
		state st3 goto st4;	// リターンバック信号待ち3
		state st4 par{
			if(VRAM_CSn==0b0){
				vmem.write(VRAM_A10 || ppu.PA<9:0>, ppu.PDout);
			}
			goto st1;
			finish;
		}
	}

	// 50MHz: 18 cycle
	stage chr_write_stg {
		first_state st1;
		state st1 par{
			chr_RW_reg := 0b0;
			chr_count := 0;
			goto st2;
		}
		state st2 par{
			chr_count++;
// 1 ちょっとノイズ
// 2 ちょっとノイズ
// 3 ok
// 4 ok
// 5 DQ4化け(あったまるとノイズが減る？)
// 6 ok
			if(chr_count==7) goto st3;
		}
		state st3 par{
			WEn_reg := 0b0;
			chr_count := 0;
			goto st4;
		}
		state st4 par{
// 1 ok
// 2 ok
			chr_count++;
			if(chr_count==4) goto st5;
		}
		state st5 par{
			WEn_reg := 0b1;
			goto st1;
			finish;
		}
	}

	// Mapper用
	stage chr_write_ack_wait {
		par{
			if(VRAM_CSn==0b0){
				vmem.write(VRAM_A10 || ppu.PA<9:0>, ppu.PDout);
			}
			chr_write(); // for Mappers
			finish;
		}
	}

	// APUのDMCは最優先なのでread_waitは必要ない
	stage apu_dmc_read {
		par{
			generate cpu_read.do(apu_dmc_adrs);
			generate apu_dmc_read_wait.do();
			finish;
		}
	}

	stage apu_dmc_read_wait {
		if(cpu.read_ack){
			apu.dmc_read_ack();
			apu.din = cpu.din;
			f_apu_dmc := 0b0;
			finish;
		}
	}

	// 50MHz/1.789772.5 = 27.9 clk 558ns
// 350ns(17.5clk)/559ns CPU cycles begin at the point where M2 goes low.
	stage phi2_tim {
		reg phi_count<5>;
		first_state st1;
		state st1 par{
			Phi2_reg := 0b0;
			phi_count := 0;
			goto st2;
		}
		state st2 par{
			phi_count++;
// 2 ok
// 8 NG
			if(phi_count==2) goto st3;
		}
		state st3 par{
			Phi2_reg := 0b1;
			phi_count := 0;
			goto st4;
		}
		state st4 par{
			phi_count++;
// 16 ok
			if(phi_count==16) goto st5;
		}
		state st5 par{
			Phi2_reg := 0b0;
			goto st1;
			finish;
		}
	}

	stage mem_clear_stg {
		first_state stw;
		state stw par{
			reg_wr init_wait<8>;
			init_wait++;
			if(/&init_wait) goto st1;
		}
		state st1 par{
			reg_wr mem_adrs<11>;
			wmem.write(mem_adrs, 0x00);
			vmem.write(mem_adrs, 0x00);
			mem_adrs++;
			if(/&mem_adrs){
				mem_cleaned();
				goto stw;
				finish;
			}
		}
	}

}
