%i "../../../DE0/SDHCcard_ctrl_SPImode.h"
%i "../../../DE0/FAT32.h"
%i "../../../TangNano9K/UART_ctrl.h"

%i "../nes_core.h"
%i "../mapper/Mapper.h"
%i "Display_5.h"
%i "VGA_ctrl.h"
%i "../../../hdl/dsdac7.h"
%i "DDS_24975to5369318.h"
%i "dsdac16.h"
%i "DDS_24975to1000.h"
%i "wave_effect.h"

declare Mapper_enable interface { output enable<256>; }

circuit core
{
	input BTN;
	output LED<6>;
//--------------------- PSRAM Interface --------------------
// 64Mbit、8MBのうち4MB+4MBで使用(2ch)、4M word 8bit x 2ch
	output psram0_adrs<22>, psram0_din<8>;
	instrout psram0_write(psram0_adrs, psram0_din);
	instrout psram0_read(psram0_adrs);
	input psram0_dout<8>, psram0_busy; reg_wr psram0_ack;
	output psram1_adrs<22>, psram1_din<8>;
	instrout psram1_write(psram1_adrs, psram1_din);
	instrout psram1_read(psram1_adrs);
	input psram1_dout<8>, psram1_busy; reg_wr psram1_ack;
//--------------------- SD_Card Interface ------------------
	output SD_CSn; // SD Card CSn
	output SD_CLK; // SD Card Clock
	output SD_CMD; // SD Card Command & Dout
	input  SD_DAT; // SD Card Data
	SDHCcard_ctrl_SPImode sdcard;
	FAT32 fat;
//--------------------- UART Interface ------------------
	input UART_RX;
	output UART_TX;
	UART_ctrl uart;
//--------------------- VGA --------------------------------
	output DVI_VS, DVI_HS, DVI_DE;
	reg DVI_VS_reg, DVI_HS_reg, DVI_DE_reg;
	output DVI_R<8>, DVI_G<8>, DVI_B<8>;
	reg DVI_R_reg<8>, DVI_G_reg<8>, DVI_B_reg<8>;
	VGA_ctrl vga;
	Display_5 dis;
//-------------------- Audio -------------------------------
	output Audio_L<16>, Audio_R<16>;
	dsdac16 dac;
//------------------------------------------------------

	reg_ws reset;

	reg_wr prg_read_ok;

	// NES
	nes_core nes;
	Mapper cart;
	Mapper_enable mapper_enable;

	reg_wr file_num<8>;

	DDS_24975to5369318 dds_ntsc;

	reg_wr pad_uart<8>;

	DDS_24975to1000 dds_nsf;
	wave_effect wave;

	sel h_code<8>;
	instrself halt(h_code);
	reg_wr halt_code_reg<8>;

	stage_name nes_line { task do(); }
	stage_name key_seek { task next(); task back(); }
	stage_name card2ram { task do(); }
	stage_name uart2ram { task do(); }
	stage_name prg_set_wait { task do(); }

	if(reset){
		generate card2ram.do();
		reset := 0b0;
	}

	instruct halt halt_code_reg := h_code;

	// PSRAM 49.95MHz対応
	psram0_ack := ^psram0_busy;
	psram1_ack := ^psram1_busy;

	SD_CSn = sdcard.CSn;
	SD_CLK = sdcard.CLK;
	SD_CMD = sdcard.CMD;
	sdcard.DAT = SD_DAT;

	instruct fat.sread sdcard.read(fat.sadrs);
	fat.sack = sdcard.ack;
	fat.sdata = sdcard.rdata;

//	uart.rate_count = 108; // 24.975 Mhz / 230400 Baud
//	uart.rate_count = 54;  // 24.975 Mhz / 460800 Baud
	uart.rate_count = 27;  // 24.975 Mhz / 921600 Baud
//	uart.rate_count = 13;  // 24.975 Mhz / 1843200 Baud
	uart.RX = UART_RX;
	UART_TX = uart.TX;

	instruct vga.nes_vsync wave.vsync();
	wave.sound = nes.sound_L;
/*
	vga.vt_su = 2;
	vga.vt_vu = 2 + 33; // 35
	vga.vt_nu = 2 + 33 + 16 -2; // 51 -2
	vga.vt_nd = 2 + 33 + 16 + 448 -2; // 499 -2
	vga.vt_vd = 2 + 33 + 480; // 515
	vga.vt_sd = 525 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 48;
	vga.ht_nu = 96 + 48 + 64;
	vga.ht_nd = 96 + 48 + 64 + 512;
	vga.ht_vd = 96 + 48 + 640;
	vga.ht_sd = 800 - 1;
*/
/*
	// 60.0988Hz @ 24.975MHz 524 lines
// ラインオーバー
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32; // 35
	vga.vt_nu = 2 + 32 + 16 -2; // 51 -2
	vga.vt_nd = 2 + 32 + 16 + 448 -2; // 499 -2
	vga.vt_vd = 2 + 32 + 480; // 515
	vga.vt_sd = 524 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 41;
	vga.ht_nu = 96 + 41 + 64;
	vga.ht_nd = 96 + 41 + 64 + 512;
	vga.ht_vd = 96 + 41 + 640;
	vga.ht_sd = 792 - 1;
*/
	// 60.01767Hz @ 24.975MHz 524 lines cpu_timing_test pass
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32; // 35
	vga.vt_nu = 2 + 32 + 16 -1; // 51 -2
	vga.vt_nd = 2 + 32 + 16 + 448 -1; // 499 -2
	vga.vt_vd = 2 + 32 + 480; // 515
	vga.vt_sd = 524 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 42;
	vga.ht_nu = 96 + 42 + 64;
	vga.ht_nd = 96 + 42 + 64 + 512;
	vga.ht_vd = 96 + 42 + 640;
	vga.ht_sd = 794 - 1;

	DVI_HS_reg := vga.hsync; DVI_HS = DVI_HS_reg; // DVIの同期信号はLowアクティブ
	DVI_VS_reg := vga.vsync; DVI_VS = DVI_VS_reg; // DVIの同期信号はLowアクティブ
	DVI_DE_reg := vga.view_valid; DVI_DE = DVI_DE_reg;

	if(vga.view_valid){
/*
//if((vga.vcount==0) | (vga.vcount==(480-3)) | (vga.hcount==0)){ // 59.94
if((vga.vcount==0) | (vga.vcount==(480-3)) | (vga.hcount==0)){ // 60
	DVI_R = 0xFF;
	DVI_G = 0xFF;
	DVI_B = 0xFF;
}
else{
*/
		if(cart.f_nsf){
			// 波形表示
			wave.read(vga.hcount, vga.vcount);
			DVI_R_reg := wave.r_out || 0b000;
			DVI_G_reg := wave.g_out || 0b000;
			DVI_B_reg := wave.b_out || 0b000;
		}
		else{
			if(vga.win_valid){
				if(cart.supported){
					// カラー正規化
					DVI_R_reg := dis.r_out || dis.r_out<4:2>;
					DVI_G_reg := dis.g_out || dis.g_out<4:2>;
					DVI_B_reg := dis.b_out || dis.b_out<4:2>;
				}
				else{
					DVI_R_reg := 0xFF;
					DVI_G_reg := 0x70;
					DVI_B_reg := 0x70;
				}
			}
			else{
				DVI_R_reg := 0x1F;
				DVI_G_reg := 0x1F;
				DVI_B_reg := 0x1F;
			}
		}
//}
	}
	else{
		DVI_R_reg := 0x00;
		DVI_G_reg := 0x00;
		DVI_B_reg := 0x00;
	}
	DVI_R = DVI_R_reg;
	DVI_G = DVI_G_reg;
	DVI_B = DVI_B_reg;

	nes.f_real_cartridge = 0b0;
	nes.f_25MHz();
	nes.IRQn = cart.IRQn;
	nes.VRAM_CSn = cart.VRAM_CSn;
	nes.VRAM_A10 = cart.VRAM_A10;
	if(^prg_read_ok) nes.ready();

//	nes.speed = SW<2>;
//	nes.stop  = 0b0;
	nes.f_nsf = cart.f_nsf;
	instruct cart.NMI_out nes.nsf_NMI();

	cart.mapper_enable = mapper_enable.enable;

	if(^prg_read_ok) cart.ready();
	instruct nes.clk_out cart.Phi();
/*
	// for NSF
	reg_wr cnt_1MHz<6>;
	if(cnt_1MHz==27){
		cart.tim1MHz();
		cnt_1MHz := 1;
	}
	else cnt_1MHz++;
*/
	cart.fat_eof = fat.eof;

//	cart.nes_sound_L = nes.sound_L;
//	cart.nes_sound_R = nes.sound_R;

//	nes.mute = 0b01111;
	dac.din = nes.sound_L || 0b00000000;

	LED = dac.dout || 0b000 || /|halt_code_reg || prg_read_ok;

	// NESPAD : 右|左|下|上|ｽﾀｰﾄ|ｾﾚｸﾄ|B|A
	nes.pad1P = (0b0000 || BTN || 0b00 || BTN) | pad_uart;
	nes.pad2P = 0x00;

	cart.ROM_SELn = nes.ROM_SELn;
	cart.prg_A = nes.prg_A;
	instruct nes.read_prg cart.prg_read();
	nes.prg_Dout = cart.prg_Dout;
	instruct cart.prg_ack nes.prg_ack();

	cart.prg_Din = nes.prg_Din;
	instruct nes.write_prg cart.prg_write();

	cart.chr_A = nes.chr_PA;
	instruct nes.read_chr par{
		// romセット時にchr_rom読み込み防止
		if(prg_read_ok) cart.chr_read();
	}
	nes.chr_PDout = cart.chr_Dout;
	instruct cart.chr_ack nes.chr_ack();

	cart.chr_Din = nes.chr_PDin;
	instruct nes.write_chr cart.chr_write();

	if(cart.prg_rom_read){
		psram0_read(0b00 || cart.prg_rom_adrs);
	}
	if(^cart.prg_rom_read & psram0_ack){
		cart.prg_rom_ack();
	}
	cart.prg_rom_rdata = psram0_dout;

	if(cart.prg_rom_write){
		psram0_write(0b00 || cart.prg_rom_adrs, cart.prg_rom_wdata);
	}

	if(cart.chr_ram_read){
		psram1_read(0b0000 || cart.chr_ram_adrs);
	}
	if(^cart.chr_ram_read & psram1_ack){
		cart.chr_ram_ack();
	}
	cart.chr_ram_rdata = psram1_dout;

	if(cart.chr_ram_write){
		psram1_write(0b0000 || cart.chr_ram_adrs, cart.chr_ram_wdata);
	}

	instruct nes.VIDEO_enable par{
		dis.write(nes.video);
	}

	// 24.975 MHz
	vga.run();

	instruct vga.dis par{
		reg_wr dis_timing;
		if(dis_timing==0b0) dis.read();
		dis_timing := ^dis_timing;
	}

	instruct vga.nes_hsync par{
		dis.bank_change();
		generate nes_line.do();
	}

	instruct dds_ntsc.run par{ // 5.369318MHz
		if(prg_read_ok){
			nes.run();
		}
	}

	instruct nes.clk_out par{
		cart.clock1789k();
	}

	reg_wr f_uart2ram, f_uart2pad;

	instruct uart.recv_valid par{
		// R(ROM), S(NSF), P(Pad)
		if(^f_uart2ram & ^f_uart2pad){
			if(uart.recv_data=='R'){
				f_uart2ram := 0b1;
				cart.set_type('R'); // R(ROM),S(NSF)
			}
			if(uart.recv_data=='S'){
				f_uart2ram := 0b1;
				cart.set_type('S'); // R(ROM),S(NSF)
			}
			if(uart.recv_data=='P') f_uart2pad := 0b1;
		}
		if(f_uart2ram){
			generate uart2ram.do();
		}
		if(f_uart2pad){
			pad_uart := uart.recv_data;
			f_uart2pad := 0b0;
		}
	}

	stage nes_line {
		reg pixel_count<9> = 1;
		par{
			if(dds_ntsc.run){

				nes.draw();

				if(pixel_count==341){
					nes.hblank();
					pixel_count := 1;
					finish;
				}
				else pixel_count++;

				if(pixel_count==260){ // 256 + 8 ?
					cart.hblank();
				}
			}
		}
	}

/*
	stage key_seek {
		first_state iwait;
		state iwait par{
			prg_read_ok := 0b0;
			goto st1;
		}
		state st1 par{
			any{
				key_seek.next : file_num++;
				key_seek.back : file_num--;
			}
			generate card2ram.do();
			goto st2;
		}
		state st2 if(^card2ram.do){
			if((key_seek.next & (^btn_2))
			 | (key_seek.back & (^btn_1))){
				goto iwait;
				finish;
			}
		}
	}
*/
	stage card2ram {
		first_state rbegin;
		state rbegin if(fat.ack){
			prg_read_ok := 0b0;
			fat.fopen(file_num);
			goto fatr;
		}
		state fatr if(fat.ack){
			fat.read();
			goto head;
		}
		state head if(fat.ack){
			cart.set_head(fat.fdata);
			fat.read();
			if(cart.head_err){
				any{
					key_seek.next : file_num++;
					key_seek.back : file_num--;
					else : file_num++;
				}
				goto rbegin;
			}
			if(cart.head_ok) goto reopen;
		}
		state reopen if(fat.ack){
			nes.mem_clear();
			fat.fopen(file_num);
			goto maps;
		}
		state maps if(fat.ack & cart.ack & psram0_ack & psram1_ack){
			//if(^fat.eof)
			 fat.read();
			cart.attach(fat.fdata);
			if(cart.set_ok) goto rend;
		}
		state rend if(psram0_ack & psram1_ack){
			nes.soft_reset();
			cart.soft_reset();
		//	prg_read_ok := 0b1;
			generate prg_set_wait.do();
			goto rbegin;
			finish;
		}
	}

	stage uart2ram {
		first_state rbegin;
		finish;
		state rbegin par{
			prg_read_ok := 0b0;
			nes.mem_clear();
		//	cart.set_type(uart.recv_data); // R(ROM),S(NSF)
			goto maps;
		}
		state maps par{
			cart.attach(uart.recv_data);
			if(cart.set_ok) goto rend;
		}
		state rend par{
			nes.soft_reset();
			cart.soft_reset();
		//	prg_read_ok := 0b1;
			generate prg_set_wait.do();
			f_uart2ram := 0b0;
			goto rbegin;
		}
	}

	stage prg_set_wait {
		if(psram0_ack & psram1_ack){
			reg_wr wait<4>;
			wait++;
			if(/&wait){
				prg_read_ok := 0b1;
				finish;
			}
		}
	}

}
