/*
	NES on FPGA feat. TangNano9K
	Copyright (c) 2023 pgate1

	PRG : PSRAM_0
	CHR : PSRAM_1
*/

%i "../../../DE0/SDHCcard_ctrl_SPImode.h"
%i "../../../DE0/FAT32.h"
%i "../../../TangNano9K/UART_ctrl.h"

%i "../NintendoEntertainmentSystem.h"
%i "../mmc/MultiMemoryController.h"
%i "Display_5.h"
%i "VGA_ctrl.h"
%i "../../../hdl/dsdac7.h"
%i "DDS_24975to5369318.h"
%i "dsdac16.h"
%i "DDS_24975to1000.h"
%i "wave_effect.h"

declare Mapper_enable interface { output enable<256>; }

circuit core
{
	input BTN;
	output LED<6>;
//--------------------- PSRAM Interface --------------------
// 64Mbit、8MBのうち4MB+4MBで使用(2ch)、4M word 8bit x 2ch
	output psram0_adrs<22>, psram0_din<8>;
	instrout psram0_write(psram0_adrs, psram0_din);
	instrout psram0_read(psram0_adrs);
	input psram0_dout<8>, psram0_busy; reg_wr psram0_ack;
	output psram1_adrs<22>, psram1_din<8>;
	instrout psram1_write(psram1_adrs, psram1_din);
	instrout psram1_read(psram1_adrs);
	input psram1_dout<8>, psram1_busy; reg_wr psram1_ack;
//--------------------- SD_Card Interface ------------------
	output SD_CSn; // SD Card CSn
	output SD_CLK; // SD Card Clock
	output SD_CMD; // SD Card Command & Dout
	input  SD_DAT; // SD Card Data
	SDHCcard_ctrl_SPImode sdcard;
	FAT32 fat;
//--------------------- UART Interface ------------------
	input UART_RX;
	output UART_TX;
	UART_ctrl uart;
	reg_wr f_uart2ram, f_uart2pad;
//--------------------- VGA --------------------------------
	output DVI_VS, DVI_HS, DVI_DE;
	reg DVI_VS_reg, DVI_HS_reg, DVI_DE_reg;
	output DVI_R<8>, DVI_G<8>, DVI_B<8>;
	reg DVI_R_reg<8>, DVI_G_reg<8>, DVI_B_reg<8>;
	VGA_ctrl vga;
	Display_5 dis;
//-------------------- Audio -------------------------------
	output Audio_L<16>, Audio_R<16>;
	dsdac16 dac;
//------------------------------------------------------

	reg_ws reset;

	reg_wr prg_read_ok;

	// NES
	NintendoEntertainmentSystem nes;
	MultiMemoryController mmc;
	Mapper_enable mapper_enable;

	reg_wr file_num<8>;

	DDS_24975to5369318 dds_ntsc;

	reg_wr pad_uart<8>;
	reg_wr uart_count<16>;

	DDS_24975to1000 dds_nsf;
	wave_effect wave;

	sel h_code<8>;
	instrself halt(h_code);
	reg_wr halt_code_reg<8>;

	stage_name nes_line { task do(); }
	stage_name key_seek { task next(); task back(); }
	stage_name card2ram { task do(); }
	stage_name uart2ram { task do(); }
	stage_name prg_set_wait { task do(); }

	if(reset){
		generate card2ram.do();
		reset := 0b0;
	}

	instruct halt halt_code_reg := h_code;

	// PSRAM 49.95MHz対応
	psram0_ack := ^psram0_busy;
	psram1_ack := ^psram1_busy;

	SD_CSn = sdcard.CSn;
	SD_CLK = sdcard.CLK;
	SD_CMD = sdcard.CMD;
	sdcard.DAT = SD_DAT;

	instruct fat.sread sdcard.read(fat.sadrs);
	fat.sack = sdcard.ack;
	fat.sdata = sdcard.rdata;

//	uart.rate_count = 108; // 24.975 Mhz / 230400 Baud
//	uart.rate_count = 54;  // 24.975 Mhz / 460800 Baud
	uart.rate_count = 27;  // 24.975 Mhz / 921600 Baud
//	uart.rate_count = 13;  // 24.975 Mhz / 1843200 Baud
	uart.RX = UART_RX;
	UART_TX = uart.TX;

	instruct vga.nes_vsync wave.vsync();
	wave.sound = nes.sound_L;
/*
	// VGA標準値
	vga.vt_su = 2;
	vga.vt_vu = 2 + 33; // 35
	vga.vt_nu = 2 + 33 + 16 -2; // 51 -2
	vga.vt_nd = 2 + 33 + 16 + 448 -2; // 499 -2
	vga.vt_vd = 2 + 33 + 480; // 515
	vga.vt_sd = 525 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 48;
	vga.ht_nu = 96 + 48 + 64;
	vga.ht_nd = 96 + 48 + 64 + 512;
	vga.ht_vd = 96 + 48 + 640;
	vga.ht_sd = 800 - 1;
*/

/*
	// cpu_timing_test pass
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32;
	vga.vt_nu = 2 + 32 + 16 -1;
	vga.vt_nd = 2 + 32 + 16 + 448 -1;
	vga.vt_vd = 2 + 32 + 480;
	vga.vt_sd = 524 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 44;
	vga.ht_nu = 96 + 44 + 64;
	vga.ht_nd = 96 + 44 + 64 + 512;
	vga.ht_vd = 96 + 44 + 640;
	vga.ht_sd = 794 - 1;
*/
	// 上下表示
	vga.vt_su = 2;
	vga.vt_vu = 2 + 32 -1;
	vga.vt_nu = 2 + 32 -1;
	vga.vt_nd = 2 + 32 + 480 -1;
	vga.vt_vd = 2 + 32 + 480 -1;
	vga.vt_sd = 524 - 1;
	vga.ht_su = 96;
	vga.ht_vu = 96 + 44;
	vga.ht_nu = 96 + 44 + 64;
	vga.ht_nd = 96 + 44 + 64 + 512;
	vga.ht_vd = 96 + 44 + 640;
	vga.ht_sd = 794 - 1;

	DVI_HS_reg := vga.hsync; DVI_HS = DVI_HS_reg; // DVIの同期信号はLowアクティブ
	DVI_VS_reg := vga.vsync; DVI_VS = DVI_VS_reg; // DVIの同期信号はLowアクティブ
	DVI_DE_reg := vga.view_valid; DVI_DE = DVI_DE_reg;

	if(vga.view_valid){
/*
//if((vga.vcount==0) | (vga.vcount==(480-3)) | (vga.hcount==0)){ // 59.94
if((vga.vcount==0) | (vga.vcount==(480-3)) | (vga.hcount==0)){ // 60
	DVI_R = 0xFF;
	DVI_G = 0xFF;
	DVI_B = 0xFF;
}
else{
*/
		if(mmc.f_nsf){
			// 波形表示
			wave.read(vga.hcount, vga.vcount);
			DVI_R_reg := wave.r_out || 0b000;
			DVI_G_reg := wave.g_out || 0b000;
			DVI_B_reg := wave.b_out || 0b000;
		}
		else{
			if(/*prg_read_ok &*/ vga.win_valid){
				if(mmc.supported){
					// カラー正規化
					DVI_R_reg := dis.r_out || dis.r_out<4:2>;
					DVI_G_reg := dis.g_out || dis.g_out<4:2>;
					DVI_B_reg := dis.b_out || dis.b_out<4:2>;
				}
				else{
					DVI_R_reg := 0xFF;
					DVI_G_reg := 0x70;
					DVI_B_reg := 0x70;
				}
			}
			else{
				DVI_R_reg := 0x1F;
				DVI_G_reg := 0x1F;
				DVI_B_reg := 0x1F;
			}
		}
//}
	}
	else{
		DVI_R_reg := 0x00;
		DVI_G_reg := 0x00;
		DVI_B_reg := 0x00;
	}
	DVI_R = DVI_R_reg;
	DVI_G = DVI_G_reg;
	DVI_B = DVI_B_reg;

	nes.f_real_cartridge = 0b0;
	nes.f_25MHz();
	nes.IRQn = mmc.IRQn;
	nes.VRAM_CSn = mmc.VRAM_CSn;
	nes.VRAM_A10 = mmc.VRAM_A10;
	if(^prg_read_ok) nes.ready();

	nes.f_nsf = mmc.f_nsf;
	instruct mmc.NMI_out nes.nsf_NMI();

	mmc.mapper_enable = mapper_enable.enable;

	if(^prg_read_ok) mmc.ready();
//	instruct nes.clk_out mmc.Phi();

	// for NSF
	instruct dds_nsf.run mmc.tim1MHz();

	mmc.fat_eof = fat.eof;

//	mmc.mute = 0b0000001; // VRC7 mute
	mmc.nes_sound_L = nes.sound_L;
	mmc.nes_sound_R = nes.sound_R;

	dac.din = nes.sound_L || 0b00000000;

	Audio_L = 0b0 || mmc.sound_L;
	if(0b0){ // 逆位相サラウンド
		Audio_R = -(0b0 || mmc.sound_R);
	}
	else{
		Audio_R = 0b0 || mmc.sound_R;
	}

	any{
		f_uart2ram : LED = uart_count<14:9>;
		else : LED = dac.dout || (pad_uart<7:5> | pad_uart<2:0>) || /|halt_code_reg || prg_read_ok;
	}

	// NESPAD : 右|左|下|上|ｽﾀｰﾄ|ｾﾚｸﾄ|B|A
	nes.pad1P = (0b0000 || BTN || 0b00 || BTN) | pad_uart;
	nes.pad2P = 0x00;

	mmc.ROM_SELn = nes.ROM_SELn;
	mmc.prg_A = nes.prg_A;
	instruct nes.prg_read mmc.prg_read();
	nes.prg_Dout = mmc.prg_Dout;
	instruct mmc.prg_ack nes.prg_ack();

	mmc.prg_Din = nes.prg_Din;
	instruct nes.prg_write mmc.prg_write();

	mmc.chr_A = nes.chr_PA;
	instruct nes.chr_read par{
		// romセット時にchr_rom読み込み防止
		if(prg_read_ok) mmc.chr_read();
	}
	nes.chr_PDout = mmc.chr_Dout;
	instruct mmc.chr_ack nes.chr_ack();

	mmc.chr_Din = nes.chr_PDin;
	instruct nes.chr_write mmc.chr_write();

	reg_wr prg_read_ack_wait, chr_read_ack_wait;

	if(mmc.prg_mem_read){
		psram0_read(0b00 || mmc.prg_mem_adrs);
		prg_read_ack_wait := 0b1;
	}
	if(prg_read_ack_wait & psram0_ack){
		mmc.prg_mem_ack();
		prg_read_ack_wait := 0b0;
	}
	mmc.prg_mem_dout = psram0_dout;

	if(mmc.prg_mem_write){
		psram0_write(0b00 || mmc.prg_mem_adrs, mmc.prg_mem_din);
	}

	if(mmc.chr_mem_read){
		psram1_read(0b000 || mmc.chr_mem_adrs);
		chr_read_ack_wait := 0b1;
	}
	if(chr_read_ack_wait & psram1_ack){
		mmc.chr_mem_ack();
		chr_read_ack_wait := 0b0;
	}
	mmc.chr_mem_dout = psram1_dout;

	if(mmc.chr_mem_write){
		psram1_write(0b000 || mmc.chr_mem_adrs, mmc.chr_mem_din);
	}

	instruct nes.VIDEO_enable par{
		dis.write(nes.video);
	}

	// 24.975 MHz
	vga.run();

	instruct vga.dis par{
		reg_wr dis_timing;
		if(dis_timing==0b0) dis.read();
		dis_timing := ^dis_timing;
	}

	instruct vga.nes_hsync par{
		dis.bank_change();
		generate nes_line.do();
	}

	instruct dds_ntsc.run par{ // 5.369318MHz
		if(prg_read_ok){
			nes.run();
		}
	}

	instruct nes.clk_out par{
		mmc.clock1789k();
	}

	instruct uart.recv_valid par{
		// R(ROM), S(NSF), P(Pad)
		if(^f_uart2ram & ^f_uart2pad){
			if(uart.recv_data=='R'){
				f_uart2ram := 0b1;
				mmc.set_type('R'); // R(ROM)
			}
			if(uart.recv_data=='S'){
				f_uart2ram := 0b1;
				mmc.set_type('S'); // S(NSF)
			}
			if(uart.recv_data=='P'){
				f_uart2pad := 0b1;
			}
		}
		if(f_uart2ram){
			generate uart2ram.do();
		}
		if(f_uart2pad){
			pad_uart := uart.recv_data;
			f_uart2pad := 0b0;
		}
	}

	stage nes_line {
		reg pixel_count<9> = 1;
		reg cpu_timing<3> = 0b001;
		par{
			if(dds_ntsc.run){

				nes.draw();

				// mmcには描画に合わせたクロックを入れてみる
				if(cpu_timing<0>) mmc.Phi();
				cpu_timing := cpu_timing<1:0> || cpu_timing<2>;

				if(pixel_count==341){
					nes.hblank();
					pixel_count := 1;
				//	cpu_timing := 0b001;
					finish;
				}
				else{
					pixel_count++;
				//	cpu_timing := cpu_timing<1:0> || cpu_timing<2>;
				}
			}
		}
	}

	stage card2ram {
		first_state st_begin;
		state st_begin if(fat.ack){
			prg_read_ok := 0b0;
			fat.fopen(file_num);
			goto st_fatr;
		}
		state st_fatr if(fat.ack){
			fat.read();
			goto st_head;
		}
		state st_head if(fat.ack){
			mmc.set_head(fat.fdata);
			fat.read();
			if(mmc.head_err){
				file_num++;
				goto st_begin;
			}
			if(mmc.head_ok) goto st_reopen;
		}
		state st_reopen if(fat.ack){
			nes.mem_clear();
			fat.fopen(file_num);
			goto st_attach;
		}
/*
		state st_attach if(fat.ack & mmc.attach_ack & psram0_ack & psram1_ack){
			//if(^fat.eof)
			 fat.read();
			mmc.attach(fat.fdata);
			if(mmc.set_ok) goto st_end;
		}
*/
		state st_attach if(fat.ack & mmc.attach_ack & psram0_ack & psram1_ack){
			//if(^fat.eof)
			 fat.read();
			mmc.attach(fat.fdata);
			if(^mmc.f_BatteryBackup & mmc.set_ok) goto st_end;
			if(mmc.f_BatteryBackup & fat.eof) goto st_open_save;
		}
		state st_open_save if(fat.ack){
			fat.fopen(file_num+1);
			goto st_read_save;
		}
		state st_read_save if(fat.ack){
			fat.read();
			goto st_write_save;
		}
		state st_write_save if(fat.ack & mmc.attach_ack){
			fat.read();
			mmc.attach(fat.fdata);
			if(mmc.set_ok) goto st_end;
		}

		state st_end if(psram0_ack & psram1_ack){
			nes.soft_reset();
			mmc.soft_reset();
		//	prg_read_ok := 0b1;
			generate prg_set_wait.do();
			goto st_begin;
			finish;
		}
	}

	stage uart2ram {
		first_state st_begin;
		finish;
		state st_begin par{
			prg_read_ok := 0b0;
			nes.mem_clear();
		//	mmc.set_type(uart.recv_data); // R(ROM),S(NSF)
			goto st_attach;
		}
		state st_attach par{
			mmc.attach(uart.recv_data);
			uart_count++;
			if(mmc.set_ok) goto st_end;
		}
		state st_end par{
			nes.soft_reset();
			mmc.soft_reset();
		//	prg_read_ok := 0b1;
			generate prg_set_wait.do();
			f_uart2ram := 0b0;
			goto st_begin;
		}
	}

	stage prg_set_wait {
		if(psram0_ack & psram1_ack){
			reg_wr wait<4>;
			wait++;
			if(/&wait){
				prg_read_ok := 0b1;
				finish;
			}
		}
	}

}
