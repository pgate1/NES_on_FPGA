
/*
	Mapper 016
	Bandai FCG chip
		PRG-ROM 16KB banks 8 16 32 max 512KB
		CHR-ROM 8KB banks 0(RAM) 4 (8) 16 32 max 256KB
*/

circuit Mapper016
{
	// PRG-ROM
	input ROM_SELn;
	instrin prg_read, prg_write;
	input prg_A<15>, prg_Din<8>;
	output prg_Dout<8>;
	output IRQn;

	// CHR-ROM
	instrin chr_read;//, chr_write; // RDn, WEn
	input chr_A<14>;//, chr_Din<8>; // chr_A13n
	output chr_Dout<8>;
	output VRAM_CSn, VRAM_A10;

	instrin Phi; // 1.789MHz
//	output usound<11>, ssound<14>;

	instrout exp_ram_read(exp_ram_adrs);
	output exp_ram_adrs<13>; // EXP_RAM 8KB
	input exp_ram_dout<8>;
	instrout exp_ram_write(exp_ram_adrs, exp_ram_din);
	output exp_ram_din<8>;

	// 外部RAMへのアクセス
	instrout prg_mem_read(prg_mem_adrs);
	output prg_mem_adrs<19>; // PRG_ROM max 512KB
	input prg_mem_dout<8>;

	instrout chr_mem_read(chr_mem_adrs);
	output chr_mem_adrs<18>; // CHR_ROM max 256KB
	input chr_mem_dout<8>;
//	instrout chr_mem_write(chr_mem_adrs, chr_mem_din);
//	output chr_mem_din<8>;

	instrin init;

	input n16kRomBanks<6>;//, n8kVRomBanks<7>, fMirroringType;
	reg_wr fMirroringType_reg<2>;

	reg prg_bank01<5>;
	sel prg_last_bank<5>;
	reg chr_bank0<8>, chr_bank1<8>, chr_bank2<8> ,chr_bank3<8>;
	reg chr_bank4<8>, chr_bank5<8>, chr_bank6<8>, chr_bank7<8>;

	instrself map_prgrom, map_exprom, map_expram;

	reg_ws IRQn_reg;
	reg irq_enable, irq_counter<16>, irq_latch<16>;

	if(ROM_SELn==0b0){
		map_prgrom();
	}
	else any{
		prg_A<14:13>==0b10 : map_exprom();
		prg_A<14:13>==0b11 : map_expram();
	}

	any{
		map_prgrom : prg_Dout = prg_mem_dout;
		map_expram : prg_Dout = exp_ram_dout;
	}

	prg_last_bank = (n16kRomBanks - 0b000001)<4:0>;

	VRAM_CSn = ^chr_A<13>;

	switch(fMirroringType_reg){
		case 0b00: VRAM_A10 = chr_A<10>;
		case 0b01: VRAM_A10 = chr_A<11>;
		case 0b10: VRAM_A10 = 0b0; // mirror 0x2000
		case 0b11: VRAM_A10 = 0b1; // mirror 0x2400
	}

	// chr_bank<8> + chr_A<10> = <18>
	sel chr_read_bank<8>;
	switch(chr_A<12:10>){
		case 0b000: chr_read_bank = chr_bank0;
		case 0b001: chr_read_bank = chr_bank1;
		case 0b010: chr_read_bank = chr_bank2;
		case 0b011: chr_read_bank = chr_bank3;
		case 0b100: chr_read_bank = chr_bank4;
		case 0b101: chr_read_bank = chr_bank5;
		case 0b110: chr_read_bank = chr_bank6;
		case 0b111: chr_read_bank = chr_bank7;
	}

	chr_Dout = chr_mem_dout;

	IRQn = IRQn_reg;
/*
	usound = // <11>
	   0b00000000000;

	ssound = // <14s>
	   0b00000000000000;
*/

	instruct init par{
		prg_bank01 := 0b00000;
		chr_bank0 := 0x00;
		chr_bank1 := 0x01;
		chr_bank2 := 0x02;
		chr_bank3 := 0x03;
		chr_bank4 := 0x04;
		chr_bank5 := 0x05;
		chr_bank6 := 0x06;
		chr_bank7 := 0x07;
	//	fMirroringType_reg := 0b0 || ^fMirroringType;
		irq_enable := 0b0;
	//	irq_counter := 0;
		irq_latch := 0;
		IRQn_reg := 0b1;
	}

	instruct prg_read any{
		map_prgrom : par{
			// prg_bank<6> + prg_A<13> = <19>
			sel prg_read_bank<6>;
			switch(prg_A<14:13>){
				case 0b00: prg_read_bank = prg_bank01 || 0b0;
				case 0b01: prg_read_bank = prg_bank01 || 0b1;
				case 0b10: prg_read_bank = prg_last_bank || 0b0;
				case 0b11: prg_read_bank = prg_last_bank || 0b1;
			}
			prg_mem_read(prg_read_bank || prg_A<12:0>);
		}
		map_expram : exp_ram_read(prg_A<12:0>);
	}

	instruct prg_write any{
		map_prgrom : par{
			switch(prg_A<3:0>){
				case 0x0: chr_bank0 := prg_Din;
				case 0x1: chr_bank1 := prg_Din;
				case 0x2: chr_bank2 := prg_Din;
				case 0x3: chr_bank3 := prg_Din;
				case 0x4: chr_bank4 := prg_Din;
				case 0x5: chr_bank5 := prg_Din;
				case 0x6: chr_bank6 := prg_Din;
				case 0x7: chr_bank7 := prg_Din;
				case 0x8: prg_bank01 := prg_Din<4:0>;
				case 0x9: fMirroringType_reg := prg_Din<1:0>;
				case 0xA: par{
					irq_enable := prg_Din<0>;
					irq_counter := irq_latch;
					IRQn_reg := 0b1;
				}
				case 0xB: irq_latch := irq_latch<15:8> || prg_Din;
				case 0xC: irq_latch := prg_Din || irq_latch<7:0>;
			}
		}
		map_expram : exp_ram_write(prg_A<12:0>, prg_Din);
	}

	instruct chr_read par{
		if(chr_A<13>==0b0){
			chr_mem_read(chr_read_bank || chr_A<9:0>);
		}
	}
/*
	instruct chr_write par{
		if(chr_A<13>==0b0){
			chr_mem_write(chr_read_bank || chr_A<9:0>, chr_Din);
		}
	}
*/
	instruct Phi par{
		if(irq_enable){
			if(irq_counter==0){
				IRQn_reg := 0;
			}
			irq_counter--;
		}
	}

}
