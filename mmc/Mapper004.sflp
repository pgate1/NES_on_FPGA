
/*
	Mapper 004
	MMC3
		PRG-ROM 16KB banks 2 4 8 16 32 max 512KB
		CHR-ROM 8KB banks 0(RAM) 1 2 4 (8) 16 32 max 256KB
		CHR-RAM
*/

circuit Mapper004
{
	// PRG-ROM
	input ROM_SELn;
	instrin prg_read, prg_write;
	input prg_A<15>, prg_Din<8>;
	output prg_Dout<8>;
	output IRQn;

	// CHR-ROM
	instrin chr_read, chr_write; // RDn, WEn
	input chr_A<14>, chr_Din<8>; // chr_A13n
	output chr_Dout<8>;
	output VRAM_CSn, VRAM_A10;

	instrin Phi; // 1.789MHz
	output usound<11>, ssound<14>;

	instrout exp_ram_read(exp_ram_adrs);
	output exp_ram_adrs<13>; // EXP_RAM 8KB
	input exp_ram_dout<8>;
	instrout exp_ram_write(exp_ram_adrs, exp_ram_din);
	output exp_ram_din<8>;

	// 外部RAMへのアクセス
	instrout prg_mem_read(prg_mem_adrs);
	output prg_mem_adrs<19>; // PRG_ROM max 512KB
	input prg_mem_dout<8>;

	instrout chr_mem_read(chr_mem_adrs);
	output chr_mem_adrs<18>; // CHR_ROM max 256KB
	input chr_mem_dout<8>;
	instrout chr_mem_write(chr_mem_adrs, chr_mem_din);
	output chr_mem_din<8>;

	instrin init;

	input n16kRomBanks<6>, n8kVRomBanks<7>, fMirroringType;
	reg fMirroringType_reg;

	reg prg_bank0<6>, prg_bank1<6>, prg_last_bank<5>;
	reg chr_bank01<7>, chr_bank23<7>; // 偶数のみ
	reg chr_bank4<8>, chr_bank5<8>, chr_bank6<8>, chr_bank7<8>;

	instrself map_prgrom, map_expram;

	reg prg_swap, chr_swap;
	reg fSaveRAMenable;
	reg IRQn_reg;
	reg command<3>;

	instrself hsync;
	reg irq_enable, irq_counter<8>, irq_latch<8>, irq_reload;

	if(ROM_SELn==0b0){
		map_prgrom();
	}
	else any{
	//	prg_A<14:13>==0b10 : map_exprom();
		prg_A<14:13>==0b11 : map_expram();
	}

	any{
		map_prgrom : prg_Dout = prg_mem_dout;
		map_expram : prg_Dout = exp_ram_dout;
	}

	VRAM_CSn = ^chr_A<13>;

	if(fMirroringType_reg){
		// 垂直ミラー, 水平スクロールタイプ
		VRAM_A10 = chr_A<10>;
	}
	else{
		// 水平ミラー, 垂直スクロールタイプ
		VRAM_A10 = chr_A<11>;
	}

	// VRAMでもchr_bankは使用している
	// chr_bank<8> + chr_A<10> = <18>
	sel chr_read_bank<8>;
	if(chr_swap){
		switch(chr_A<12:10>){
			case 0b000: chr_read_bank = chr_bank4;
			case 0b001: chr_read_bank = chr_bank5;
			case 0b010: chr_read_bank = chr_bank6;
			case 0b011: chr_read_bank = chr_bank7;
			case 0b100: chr_read_bank = chr_bank01 || 0b0;
			case 0b101: chr_read_bank = chr_bank01 || 0b1;
			case 0b110: chr_read_bank = chr_bank23 || 0b0;
			case 0b111: chr_read_bank = chr_bank23 || 0b1;
		}
	}
	else{
		switch(chr_A<12:10>){
			case 0b000: chr_read_bank = chr_bank01 || 0b0;
			case 0b001: chr_read_bank = chr_bank01 || 0b1;
			case 0b010: chr_read_bank = chr_bank23 || 0b0;
			case 0b011: chr_read_bank = chr_bank23 || 0b1;
			case 0b100: chr_read_bank = chr_bank4;
			case 0b101: chr_read_bank = chr_bank5;
			case 0b110: chr_read_bank = chr_bank6;
			case 0b111: chr_read_bank = chr_bank7;
		}
	}

	chr_Dout = chr_mem_dout;

	IRQn = IRQn_reg;

	usound = // <11>
	   0b00000000000;

	ssound = // <14s>
	   0b00000000000000;

	instruct init par{
		prg_swap := 0;
		chr_swap := 0;
		command := 0;
		prg_bank0 := 0b000000;
		prg_bank1 := 0b000001;
		prg_last_bank := (n16kRomBanks - 0b000001)<4:0>;
		chr_bank01 := 0b0000000; // 0x00
		chr_bank23 := 0b0000001; // 0x02
		chr_bank4 := 0x04;
		chr_bank5 := 0x05;
		chr_bank6 := 0x06;
		chr_bank7 := 0x07;
		fSaveRAMenable := 0;
		fMirroringType_reg := fMirroringType;
		irq_enable := 0b0;
		irq_counter := 0;
		irq_latch := 0;
		irq_reload := 0b0;
		IRQn_reg := 0b1;
	}

	instruct prg_read any{
		map_prgrom : par{
			// prg_bank<6> + prg_A<13> = <19>
			sel prg_read_bank<6>;
			if(prg_swap){
				switch(prg_A<14:13>){
					case 0b00: prg_read_bank = prg_last_bank || 0b0;
					case 0b01: prg_read_bank = prg_bank1;
					case 0b10: prg_read_bank = prg_bank0;
					case 0b11: prg_read_bank = prg_last_bank || 0b1;
				}
			}
			else{
				switch(prg_A<14:13>){
					case 0b00: prg_read_bank = prg_bank0;
					case 0b01: prg_read_bank = prg_bank1;
					case 0b10: prg_read_bank = prg_last_bank || 0b0;
					case 0b11: prg_read_bank = prg_last_bank || 0b1;
				}
			}
			prg_mem_read(prg_read_bank || prg_A<12:0>);
		}
		map_expram : exp_ram_read(prg_A<12:0>);
	}

	instruct prg_write any{
		map_prgrom : par{
			switch(prg_A<14:13> || prg_A<0>){
				case 0b000: par{ // $8000 Command
					chr_swap := prg_Din<7>;
					prg_swap := prg_Din<6>;
					command := prg_Din<2:0>;
				}
				case 0b001: par{ // $8001 Page Number for Command
					switch(command){
						case 0b000: chr_bank01 := prg_Din<7:1>;
						case 0b001: chr_bank23 := prg_Din<7:1>;
						case 0b010: chr_bank4 := prg_Din;
						case 0b011: chr_bank5 := prg_Din;
						case 0b100: chr_bank6 := prg_Din;
						case 0b101: chr_bank7 := prg_Din;
						case 0b110: prg_bank0 := prg_Din<5:0>;
						case 0b111: prg_bank1 := prg_Din<5:0>;
					}
				}
				case 0b010: par{ // $A000 Mirroring Select
					fMirroringType_reg := ^prg_Din<0>;
				}
				case 0b011: par{ // $A001 SaveRAM Toggle
					fSaveRAMenable := prg_Din<7>;
				}
				case 0b100: par{ // $C000
					irq_counter := prg_Din;
				}
				case 0b101: par{ // $C001
					irq_latch := prg_Din;
				}
				case 0b110: par{ // $E000
				//	irq_counter := irq_latch;
					irq_enabled := 0b0;
					IRQn_reg := 0b1;
				}
				case 0b111: par{ // $E001
					irq_enabled := 0b1;
			//		IRQn_reg := 0b1;
				}
			}
		}
		map_expram : if(fSaveRAMenable) exp_ram_write(prg_A<12:0>, prg_Din);
	}

	instruct chr_read par{
		if(chr_A<13>==0b0){
			chr_mem_read(chr_read_bank || chr_A<9:0>); // <8><10> 256 x 1kB
		}

		if(chr_A<13>==0b0) f_draw := 0b1;
	//	if(chr_A<12> & ^pre_chr_A12) hblank_begin();
		pre_chr_A12 := chr_A<12>;
	}

	instruct chr_write par{
		if(chr_A<13>==0b0){
			chr_mem_write(chr_read_bank || chr_A<9:0>, chr_Din);
		}
	}

	instruct hblank par{

	// VBlank中はIRQは発生させないこと
	// vcountはVBlankから開始するでok
	//	reg_wr vcount<8>;
	//	reg_ws vblank;
/*
		any{
			vblank & (vcount==0x15) : par{ // 21
				vcount := 0x00;
				vblank := 0b0;
			}
			(^vblank) & (vcount==0xEF) : par{ // 239
				vcount := 0x00;
				vblank := 0b1;
			}
			else : vcount++;
		}
*/
//		if(irq_enabled & (^vblank)){
		if(irq_enabled & f_draw){
//		if(irq_enabled){
			if(irq_counter==0x00){
				irq_counter := irq_latch;
				IRQn_reg := 0b0;
			}
			else irq_counter--;
		}
		f_draw := 0b0;
	}

}
