
/*
	Mapper 019
	Namco 129/163
		PRG-ROM 16KB banks 2 (4) 8 16 32 max 512KB
		CHR-ROM 8KB banks 16 32 max 256KB
		CHR-RAM (nsf.nes)
*/

%i "n106/n106_core.h"

circuit Mapper019
{
	// PRG-ROM
	input ROM_SELn;
	instrin prg_read, prg_write;
	input prg_A<15>, prg_Din<8>;
	output prg_Dout<8>;
	reg prg_Dout_reg<8>;
	output IRQn;

	// CHR-ROM
	instrin chr_read, chr_write; // RDn, WEn
	input chr_A<14>, chr_Din<8>; // chr_A13n
	output chr_Dout<8>;
	output VRAM_CSn, VRAM_A10;

	instrin Phi; // 1.789MHz
	output usound<11>, ssound<14>;

	instrout exp_ram_read(exp_ram_adrs);
	output exp_ram_adrs<13>; // EXP_RAM 8KB
	input exp_ram_dout<8>;
	instrout exp_ram_write(exp_ram_adrs, exp_ram_din);
	output exp_ram_din<8>;

	// 外部RAMへのアクセス
	instrout prg_mem_read(prg_mem_adrs);
	output prg_mem_adrs<19>; // PRG_ROM max 512KB
	input prg_mem_dout<8>;

	instrout chr_mem_read(chr_mem_adrs);
	output chr_mem_adrs<18>; // CHR_ROM max 256KB
	input chr_mem_dout<8>;
	instrout chr_mem_write(chr_mem_adrs, chr_mem_din);
	output chr_mem_din<8>;

	instrin ready, init;

//input dbg<8>;

	input n16kRomBanks<6>, n8kVRomBanks<7>, fMirroringType;

	reg prg_bank4<6>, prg_bank5<6>, prg_bank6<6>, prg_bank7<6>;
	reg chr_bank0<8>, chr_bank1<8>, chr_bank2<8>, chr_bank3<8>;
	reg chr_bank4<8>, chr_bank5<8>, chr_bank6<8>, chr_bank7<8>;
	reg chr_bank8<8>, chr_bank9<8>, chr_bank10<8>, chr_bank11<8>;

	instrself map_prgrom, map_exprom, map_expram;

	reg_ws IRQn_reg;

	instrin run1789;
	n106_core n106;

	reg regs0, regs1;
	mem nametable_enable[12];
	reg irq_enable, irq_counter<15>;

	instrout exp_rom_ack;

	reg prg_mask<6>, chr_mask<8>;
	sel chr_bank<8>;

	if(ROM_SELn==0b0){
		map_prgrom();
	}
	else any{
		prg_A<14:13>==0b10 : map_exprom();
		prg_A<14:13>==0b11 : map_expram();
	}

	any{
		map_exprom : any{
			prg_A<12:10>==0b010 : par{ // $4800
				prg_Dout = n106.io_Dout;
			}
			else : prg_Dout = prg_Dout_reg;
		}
		map_expram : prg_Dout = exp_ram_dout;
		map_prgrom : prg_Dout = prg_mem_dout;
	}

	if(chr_A<13>==0b0){ // 0x0000-0x1FFF パターン
		VRAM_CSn = ^nametable_enable[0b0 || chr_A<12:10>];
		// chr_bank<8> + chr_A<10> = <18>
		switch(chr_A<12:10>){
			case 0b000: par{
				VRAM_A10 = chr_bank0<0>;
				chr_bank = chr_bank0;
			}
			case 0b001: par{
				VRAM_A10 = chr_bank1<0>;
				chr_bank = chr_bank1;
			}
			case 0b010: par{
				VRAM_A10 = chr_bank2<0>;
				chr_bank = chr_bank2;
			}
			case 0b011: par{
				VRAM_A10 = chr_bank3<0>;
				chr_bank = chr_bank3;
			}
			case 0b100: par{
				VRAM_A10 = chr_bank4<0>;
				chr_bank = chr_bank4;
			}
			case 0b101: par{
				VRAM_A10 = chr_bank5<0>;
				chr_bank = chr_bank5;
			}
			case 0b110: par{
				VRAM_A10 = chr_bank6<0>;
				chr_bank = chr_bank6;
			}
			case 0b111: par{
				VRAM_A10 = chr_bank7<0>;
				chr_bank = chr_bank7;
			}
		}
	}
	else{ // 0x2000-0x2FFF NameTable or CHR-ROM
		VRAM_CSn = ^nametable_enable[0b10 || chr_A<11:10>];
		switch(chr_A<11:10>){ // 10_xx--_----_----
			case 0b00: par{ // 0x2000-0x23FF
				VRAM_A10 = chr_bank8<0>;
				chr_bank = chr_bank8;
			}
			case 0b01: par{ // 0x2400-0x27FF
				VRAM_A10 = chr_bank9<0>;
				chr_bank = chr_bank9;
			}
			case 0b10: par{ // 0x2800-0x2BFF
				VRAM_A10 = chr_bank10<0>;
				chr_bank = chr_bank10;
			}
			case 0b11: par{ // 0x2C00-0x2FFF
				VRAM_A10 = chr_bank11<0>;
				chr_bank = chr_bank11;
			}
		}
	}

	chr_Dout = chr_mem_dout;

	IRQn = IRQn_reg;

	usound = // <11>
		0b00 || n106.sound || 0b00;

	ssound = // <14s>
	   0b00000000000000;

	instruct ready n106.ready();

	instruct init par{
		prg_bank4 := 0b000000;
		prg_bank5 := 0b000001;
		prg_bank6 := 0b111110; //(n16kRomBanks - 0b000001)<4:0> || 0b0;
		prg_bank7 := 0b111111; //(n16kRomBanks - 0b000001)<4:0> || 0b1;
		prg_mask  := (n16kRomBanks - 0b000001)<4:0> || 0b1;
		chr_bank0 := 0x00;
		chr_bank1 := 0x01;
		chr_bank2 := 0x02;
		chr_bank3 := 0x03;
		chr_bank4 := 0x04;
		chr_bank5 := 0x05;
		chr_bank6 := 0x06;
		chr_bank7 := 0x07;
		chr_mask := (n8kVRomBanks - 0b0000001)<4:0> || 0b111;
		if(fMirroringType){
			chr_bank8 := 0x00;
			chr_bank9 := 0x01;
			chr_bank10 := 0x00;
			chr_bank11 := 0x01;
		}
		else{
			chr_bank8 := 0x00;
			chr_bank9 := 0x00;
			chr_bank10 := 0x01;
			chr_bank11 := 0x01;
		}
		par(i=0;i<8;i++){
			nametable_enable[i] := 0b0;
		}
		par(i=8;i<12;i++){
			nametable_enable[i] := 0b1;
		}
		regs0 := 0b0;
		regs1 := 0b0;
		irq_enable := 0b0;
		irq_counter := 0;
	}

	reg_wr exp_rom_ack_wait;

	instruct prg_read any{
		map_exprom : par{
			switch(prg_A<12:11>){
				case 0b01: par{ // $4800
					n106.io_read(0b0);
				}
				case 0b10: par{ // $5000
					prg_Dout_reg := irq_counter<7:0>;
				}
				case 0b11: par{ // $5800
					prg_Dout_reg := 0b0 || irq_counter<14:8>;
				}
				default: prg_Dout_reg := 0b0 || prg_A<14:8>;
			}
			exp_rom_ack_wait := 0b1;
		}
		map_prgrom : par{
			// prg_bank<6> + prg_A<13> = <19>
			sel prg_read_bank<6>;
			switch(prg_A<14:13>){
				case 0b00: prg_read_bank = prg_bank4;
				case 0b01: prg_read_bank = prg_bank5;
				case 0b10: prg_read_bank = prg_bank6;
				case 0b11: prg_read_bank = prg_bank7;
			}
			prg_mem_read((prg_read_bank & prg_mask) || prg_A<12:0>);
		}
		map_expram : exp_ram_read(prg_A<12:0>);
	}

	if(exp_rom_ack_wait){
		exp_rom_ack_wait := 0b0;
		exp_rom_ack();
	}

	instruct prg_write any{
		map_exprom : par{
			switch(prg_A<12:11>){
				case 0b01: par{ // $4800
					n106.io_write(0b0, prg_Din);
				}
				case 0b10: par{ // $5000
					irq_counter := irq_counter<14:8> || prg_Din;
					IRQn_reg := 0b1;
				}
				case 0b11: par{ // $5800
					irq_counter := prg_Din<6:0> || irq_counter<7:0>;
					irq_enable := prg_Din<7>;
					IRQn_reg := 0b1;
				}
			}
		}
		map_prgrom : par{
			switch(prg_A<14:11>){
				case 0b0000: par{ // $8000
					chr_bank0 := prg_Din;
					nametable_enable[0] := (prg_Din<7:5>==0b111) & (regs0==0b0);
				}
				case 0b0001: par{ // $8800
					chr_bank1 := prg_Din;
					nametable_enable[1] := (prg_Din<7:5>==0b111) & (regs0==0b0);
				}
				case 0b0010: par{ // $9000
					chr_bank2 := prg_Din;
					nametable_enable[2] := (prg_Din<7:5>==0b111) & (regs0==0b0);
				}
				case 0b0011: par{ // $9800
					chr_bank3 := prg_Din;
					nametable_enable[3] := (prg_Din<7:5>==0b111) & (regs0==0b0);
				}
				case 0b0100: par{ // $A000
					chr_bank4 := prg_Din;
					nametable_enable[4] := (prg_Din<7:5>==0b111) & (regs1==0b0);
				}
				case 0b0101: par{ // $A800
					chr_bank5 := prg_Din;
					nametable_enable[5] := (prg_Din<7:5>==0b111) & (regs1==0b0);
				}
				case 0b0110: par{ // $B000
					chr_bank6 := prg_Din;
					nametable_enable[6] := (prg_Din<7:5>==0b111) & (regs1==0b0);
				}
				case 0b0111: par{ // $B800
					chr_bank7 := prg_Din;
					nametable_enable[7] := (prg_Din<7:5>==0b111) & (regs1==0b0);
				}
				case 0b1000: par{ // $C000
					chr_bank8 := prg_Din;
					nametable_enable[8] := (prg_Din<7:5>==0b111);
				}
				case 0b1001: par{ // $C800
					chr_bank9 := prg_Din;
					nametable_enable[9] := (prg_Din<7:5>==0b111);
				}
				case 0b1010: par{ // $D000
					chr_bank10 := prg_Din;
					nametable_enable[10] := (prg_Din<7:5>==0b111);
				}
				case 0b1011: par{ // $D800
					chr_bank11 := prg_Din;
					nametable_enable[11] := (prg_Din<7:5>==0b111);
				}
				case 0b1100: par{ // $E000
					prg_bank4 := prg_Din<5:0>;
				}
				case 0b1101: par{ // $E800
					prg_bank5 := prg_Din<5:0>;
					regs0 := prg_Din<6>;
					regs1 := prg_Din<7>;
				}
				case 0b1110: par{ // $F000
					prg_bank6 := prg_Din<5:0>;
				}
				case 0b1111: par{ // $F800
					n106.io_write(0b1, prg_Din);
				}
			}
		}
		map_expram : /*if(fSaveRAMenable)*/ exp_ram_write(prg_A<12:0>, prg_Din);
	}

	instruct chr_read par{
		if(VRAM_CSn==0b1){
			chr_mem_read((chr_bank & chr_mask) || chr_A<9:0>);
		}
	}

	instruct chr_write if(n8kVRomBanks==0){
		if(VRAM_CSn==0b1){
			chr_mem_write((chr_bank & chr_mask) || chr_A<9:0>, chr_Din);
		}
	}

	instruct run1789 n106.run();

	instruct Phi par{
		if(irq_enable){
			if(/&irq_counter){ // 0x7FFF
				irq_enable := 0b0;
				IRQn_reg := 0b0;
			}
			else irq_counter++;
		}
	}

}
