
// RGB ROM
// 3 bit color x 3 = 64 color max

circuit RGB_rom_3
{
	input adrs<6>;
	output dout<9>;
	reg dout_reg<12>;
	instrin read(adrs);

	mem cells[64]<12> = {
		0x124, 0x005, 0x045, 0x105, 0x143, 0x140, 0x140, 0x108, 0x0C8, 0x008, 0x010, 0x009, 0x00B, 0x000, 0x000, 0x000, 
		0x1B6, 0x017, 0x08F, 0x14E, 0x1CD, 0x1CA, 0x1C8, 0x190, 0x198, 0x058, 0x020, 0x023, 0x026, 0x000, 0x000, 0x000, 
		0x1FF, 0x027, 0x0E7, 0x19F, 0x1DE, 0x1DC, 0x1DA, 0x1E2, 0x1E9, 0x168, 0x0B3, 0x0B5, 0x037, 0x0DB, 0x000, 0x000, 
		0x1FF, 0x12F, 0x16F, 0x1AF, 0x1EF, 0x1EE, 0x1F5, 0x1F5, 0x1F5, 0x1BC, 0x17D, 0x17F, 0x17F, 0x1B6, 0x000, 0x000
	};

	instruct read dout_reg := cells[adrs];
	dout = dout_reg<8:0>;
}
