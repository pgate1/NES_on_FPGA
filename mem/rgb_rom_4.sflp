
// RGB ROM
// 4 bit color x 3 = 64 color max

circuit rgb_rom_4
{
	input adrs<6>;
	output dout<12>;
	instrin read(adrs);

	mem cells[64]<12> = {
		0x888, 0x00B, 0x30B, 0x80A, 0xB06, 0xB01, 0xB00, 0x920, 
		0x720, 0x030, 0x040, 0x032, 0x026, 0x000, 0x000, 0x000, 
		0xCCC, 0x05F, 0x43F, 0xB3C, 0xF3A, 0xF35, 0xF31, 0xD40, 
		0xC60, 0x370, 0x181, 0x096, 0x08C, 0x111, 0x000, 0x000, 
		0xFFF, 0x09F, 0x68F, 0xD6F, 0xF7C, 0xF69, 0xF75, 0xF95, 
		0xFA3, 0xAB0, 0x5D6, 0x4DA, 0x0DF, 0x666, 0x000, 0x000, 
		0xFFF, 0x8BF, 0xBBF, 0xDBF, 0xFBE, 0xFBC, 0xFCB, 0xFCA, 
		0xFDA, 0xCE9, 0xAEB, 0xAFE, 0xBEF, 0xDDD, 0x111, 0x111
	};

	reg dout_reg<12>;

	instruct read dout_reg := cells[adrs];
	dout = dout_reg;
}
